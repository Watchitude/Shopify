<section id="knead" style="max-width:1400px;margin:0 auto;padding:64px 32px 8px"> <div style="display:grid;grid-template-columns:1.15fr 1fr;gap:56px;align-items:center"> <div style="background:#F4F4F5;border-radius:14px;padding:16px"><div style="position:relative;aspect-ratio:4/3;border-radius:8px;overflow:hidden">{% if p_sushi.featured_image %}<img src="{{ p_sushi.featured_image | image_url: width: 1200 }}" alt="{{ p_sushi.title }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover">{% endif %}</div></div> <div> <p style="margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#D71920">Season 2</p> <h2 style="margin:0 0 16px;font-family:'Jost','Century Gothic',Futura,sans-serif;font-weight:700;font-size:52px;line-height:1;letter-spacing:-.045em;text-transform:lowercase">nine to find. one is rare.</h2> <p style="margin:0 0 24px;font-size:17px;line-height:1.6;color:#5A5A61;max-width:46ch">Every flavour has eight common styles and one chase. In sushi that's Poppy, the special roll. Boxes are sealed, so the only way to know is to open one.</p> <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:26px"> {% for image in p_sushi.images limit: 9 %}<div style="position:relative;aspect-ratio:1;border-radius:8px;overflow:hidden;background:#F4F4F5{% if forloop.last %};border:2px solid #D71920{% endif %}"><img src="{{ image | image_url: width: 400 }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:8%"></div>{% endfor %} <div style="aspect-ratio:1;border-radius:8px;background:#101012;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:6px"><span style="font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase">Poppy</span><span style="font-size:10px;color:#9a9aa2">the chase</span></div> </div> <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"> 