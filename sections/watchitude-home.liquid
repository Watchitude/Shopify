{% stylesheet %}
  /* ============================================================
     Watchitude home
     Tunable tokens live here. Adjust these, not the rules below.

     The shared palette lives on .wt-home, the template's outermost
     wrapper, so it resolves for every descendant regardless of
     nesting -- including elements outside a .wt-section, such as the
     full-bleed .wt-bubble band.

     The --wt-section-* geometry tokens deliberately stay on
     .wt-section: they are that class's own contract, no descendant
     reads them, and keeping them there means .wt-section still works
     standalone if it is ever used outside this template.

     Both scopes are class-scoped, so nothing leaks globally even
     though this CSS is bundled into the shared styles.css.
     ============================================================ */

  .wt-home {
    --wt-font-body: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    --wt-font-display: 'Jost', 'Century Gothic', Futura, sans-serif;

    --wt-red: #D71920;
    --wt-ink: #101012;
    --wt-mist: #F4F4F5;
    --wt-line: #E2E2E4;
    --wt-muted: #5A5A61;

    --wt-card-radius: 14px;
    --wt-card-gap: 20px;
    --wt-btn-radius: 6px;

    font-family: var(--wt-font-body);
    color: var(--wt-ink);
    background: #fff;
  }
  .wt-section {
    --wt-section-max: 1400px;
    --wt-section-pad-x: 32px;
    --wt-section-pad-top: 32px;
    --wt-section-pad-bottom: 8px;

    max-width: var(--wt-section-max);
    margin: 0 auto;
    padding: var(--wt-section-pad-top) var(--wt-section-pad-x) var(--wt-section-pad-bottom);
  }

  /* ---------- hero: layout ---------- */
  .wt-hero__grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--wt-card-gap);
    align-items: stretch;
  }

  .wt-hero__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--wt-card-gap);
  }

  /* ---------- hero: shared media layer ---------- */
  .wt-hero__media {
    position: absolute;
    inset: 0;
  }

  .wt-hero__media--dim {
    opacity: 0.85;
  }

  .wt-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- hero: feature panel ---------- */
  .wt-hero__feature {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .wt-hero__overlay {
    position: relative;
    pointer-events: none;
    padding: 40px;
    background: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.92) 0%,
      rgba(16, 16, 18, 0.8) 62%,
      rgba(16, 16, 18, 0) 100%
    );
  }

  .wt-hero__title {
    margin: 0 0 14px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
    color: #fff;
    max-width: 15ch;
  }

  .wt-hero__lead {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.5;
    color: #fff;
    max-width: 46ch;
    opacity: 0.92;
  }

  .wt-hero__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .wt-hero__pill {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: var(--wt-btn-radius);
    border: 1px solid rgba(255, 255, 255, 0.55);
  }

  .wt-hero__price {
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.015em;
  }

  /* ---------- hero: side cards ---------- */
  .wt-hero__card {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    min-height: 270px;
    display: flex;
    text-decoration: none;
  }

  .wt-hero__card--dark {
    background: var(--wt-ink);
  }

  .wt-hero__card-overlay {
    position: relative;
    pointer-events: none;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.92) 0%,
      rgba(16, 16, 18, 0.78) 60%,
      rgba(16, 16, 18, 0) 100%
    );
    width: 100%;
  }

  .wt-hero__card-title {
    margin: 0 0 8px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    color: #fff;
  }

  .wt-hero__card-copy {
    margin: 0;
    font-size: 15px;
    color: #fff;
    opacity: 0.92;
  }

  /* ---------- shared: eyebrow + primary button ---------- */
  .wt-hero__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  .wt-hero__eyebrow--feature {
    margin-bottom: 10px;
  }

  .wt-btn {
    background: var(--wt-red);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    padding: 15px 26px;
    border-radius: var(--wt-btn-radius);
  }

  .wt-btn--nowrap {
    white-space: nowrap;
  }

  /* ============================================================
     "Just landed" band  (#new)
     Section padding matches the .wt-section defaults, so there is
     no --wt-section-pad-* override here.
     ============================================================ */
  .wt-new {
    --wt-new-media-width: 340px;
    --wt-new-gap: 32px;
  }

  .wt-new__card {
    display: grid;
    grid-template-columns: var(--wt-new-media-width) 1fr auto;
    gap: var(--wt-new-gap);
    align-items: center;
    background: #fff;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-card-radius);
    overflow: hidden;
  }

  .wt-new__media {
    position: relative;
    aspect-ratio: 16/11;
    background: var(--wt-mist);
  }

  .wt-new__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
  }

  .wt-new__body {
    padding: 26px 0;
  }

  .wt-new__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-new__title {
    margin: 0 0 10px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 38px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-new__copy {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 52ch;
  }

  .wt-new__buy {
    padding: 26px 32px 26px 0;
    display: grid;
    gap: 14px;
    justify-items: end;
  }

  .wt-new__price {
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  /* ============================================================
     "Pick a flavour" three-card row
     Per-section token overrides must stay AFTER .wt-section —
     same specificity, so source order decides the winner.
     ============================================================ */
  .wt-flavour {
    --wt-section-pad-top: 40px; /* .wt-section default is 32px */
    --wt-flavour-gap: 24px;
    --wt-flavour-radius: 10px;
  }

  .wt-flavour__heading {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wt-muted);
  }

  .wt-flavour__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--wt-flavour-gap);
  }

  /* Inert on the two <div> cards (these are div defaults); carries
     the link reset on the sushi <a>. Applied to all three so the
     cards stay stylable as one set. */
  .wt-flavour__card {
    text-decoration: none;
    color: inherit;
  }

  .wt-flavour__media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-flavour-radius);
    overflow: hidden;
    background: var(--wt-mist);
    margin-bottom: 12px;
  }

  .wt-flavour__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
  }

  .wt-flavour__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--wt-ink);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .wt-flavour__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }

  .wt-flavour__name {
    font-weight: 500;
    font-size: 16px;
  }

  .wt-flavour__price {
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .wt-flavour__meta {
    font-size: 13px;
    color: var(--wt-muted);
  }
  /* ============================================================
     "Nine to find" band  (#knead)
     ============================================================ */
  .wt-knead {
    --wt-section-pad-top: 64px; /* .wt-section default is 32px */

    --wt-knead-gap: 56px;
    --wt-knead-tile-radius: 8px;
    --wt-knead-chase-meta: #9a9aa2;
  }

  .wt-knead__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--wt-knead-gap);
    align-items: center;
  }

  .wt-knead__frame {
    background: var(--wt-mist);
    border-radius: var(--wt-card-radius);
    padding: 16px;
  }

  .wt-knead__media {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: var(--wt-knead-tile-radius);
    overflow: hidden;
  }

  .wt-knead__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wt-knead__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-knead__title {
    margin: 0 0 16px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-knead__body {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 46ch;
  }

  .wt-knead__styles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 26px;
  }

  .wt-knead__tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-knead-tile-radius);
    overflow: hidden;
    background: var(--wt-mist);
  }

  .wt-knead__tile--chase {
    border: 2px solid var(--wt-red);
  }

  .wt-knead__tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
  }

  .wt-knead__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .wt-knead__chase {
    aspect-ratio: 1;
    border-radius: var(--wt-knead-tile-radius);
    background: var(--wt-ink);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px;
  }

  .wt-knead__chase-name {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .wt-knead__chase-meta {
    font-size: 10px;
    color: var(--wt-knead-chase-meta);
  }
  /* ============================================================
     "Endless bubble wrap" band  (#bubble)
     Full-bleed tint: the <section> spans the full width and carries
     the background, while .wt-bubble__inner holds the usual
     .wt-section measure and padding.

     The padding override is written as .wt-section.wt-bubble__inner
     so it outranks .wt-section on specificity, not on source order.

     .wt-bubble sits outside .wt-section but inside .wt-home, so the
     shared palette resolves on it directly.
     ============================================================ */
  .wt-bubble {
    background: var(--wt-mist);
    margin-top: 64px;
  }

  .wt-section.wt-bubble__inner {
    --wt-section-pad-top: 64px;
    --wt-section-pad-bottom: 64px;
  }

  .wt-bubble__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .wt-bubble__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-bubble__title {
    margin: 0;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-bubble__lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 44ch;
  }
  /* ============================================================
     "Tag'd 2" band  (#tagd)
     Compound selector on the section so the padding override
     outranks .wt-section on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-tagd {
    --wt-section-pad-top: 72px; /* .wt-section default is 32px */

    --wt-tagd-gap: 56px;
    --wt-tagd-step-size: 26px;
    --wt-tagd-card-radius: 10px;
  }

  .wt-tagd__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--wt-tagd-gap);
    align-items: center;
  }

  .wt-tagd__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-tagd__title {
    margin: 0 0 16px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-tagd__body {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 46ch;
  }

  /* ---------- tag'd: numbered steps ---------- */
  .wt-tagd__steps {
    display: grid;
    gap: 14px;
    margin-bottom: 28px;
    max-width: 44ch;
  }

  .wt-tagd__step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .wt-tagd__step-num {
    flex: 0 0 auto;
    width: var(--wt-tagd-step-size);
    height: var(--wt-tagd-step-size);
    border-radius: 999px;
    background: var(--wt-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wt-tagd__step-num--accent {
    background: var(--wt-red);
  }

  .wt-tagd__step-text {
    font-size: 15px;
    line-height: 1.5;
  }

  .wt-tagd__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* ---------- tag'd: feature image ---------- */
  .wt-tagd__media {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-ink);
    aspect-ratio: 4/3;
  }

  /* Identical fill today; kept as separate hooks so the feature
     image and the collection thumbs can diverge later. */
  .wt-tagd__img,
  .wt-tagd__card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
  }

  /* ---------- tag'd: collection row ---------- */
  .wt-tagd__row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .wt-tagd__card {
    text-decoration: none;
    color: inherit;
  }

  .wt-tagd__card-media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-tagd-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    margin-bottom: 10px;
  }

  .wt-tagd__card-name {
    font-size: 14px;
    font-weight: 500;
  }
{% endstylesheet %}
