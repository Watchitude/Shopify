{% stylesheet %}
  /* ============================================================
     Watchitude home
     Tunable tokens live here. Adjust these, not the rules below.

     The shared palette lives on .wt-home, the template's outermost
     wrapper, so it resolves for every descendant regardless of
     nesting -- including elements outside a .wt-section, such as the
     full-bleed .wt-bubble band.

     The --wt-section-* geometry tokens deliberately stay on
     .wt-section: they are that class's own contract, no descendant
     reads them, and keeping them there means .wt-section still works
     standalone if it is ever used outside this template.

     Both scopes are class-scoped, so nothing leaks globally even
     though this CSS is bundled into the shared styles.css.
     ============================================================ */

  .wt-home {
    --wt-font-body: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    --wt-font-display: 'Jost', 'Century Gothic', Futura, sans-serif;

    --wt-red: #D71920;
    --wt-ink: #101012;
    --wt-mist: #F4F4F5;
    --wt-line: #E2E2E4;
    --wt-muted: #5A5A61;
    --wt-faint: #9a9aa2;

    --wt-card-radius: 14px;
    --wt-card-gap: 20px;
    --wt-btn-radius: 6px;

    font-family: var(--wt-font-body);
    color: var(--wt-ink);
    background: #fff;
  }
  .wt-section {
    --wt-section-max: 1400px;
    --wt-section-pad-x: 32px;
    --wt-section-pad-top: 32px;
    --wt-section-pad-bottom: 8px;

    max-width: var(--wt-section-max);
    margin: 0 auto;
    padding: var(--wt-section-pad-top) var(--wt-section-pad-x) var(--wt-section-pad-bottom);
  }

  /* ---------- hero: layout ---------- */
  .wt-hero__grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--wt-card-gap);
    align-items: stretch;
  }

  .wt-hero__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--wt-card-gap);
  }

  /* ---------- hero: shared media layer ---------- */
  .wt-hero__media {
    position: absolute;
    inset: 0;
  }

  .wt-hero__media--dim {
    opacity: 0.85;
  }

  .wt-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- hero: feature panel ---------- */
  .wt-hero__feature {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .wt-hero__overlay {
    position: relative;
    pointer-events: none;
    padding: 40px;
    background: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.92) 0%,
      rgba(16, 16, 18, 0.8) 62%,
      rgba(16, 16, 18, 0) 100%
    );
  }

  .wt-hero__title {
    margin: 0 0 14px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
    color: #fff;
    max-width: 15ch;
  }

  .wt-hero__lead {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.5;
    color: #fff;
    max-width: 46ch;
    opacity: 0.92;
  }

  .wt-hero__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .wt-hero__pill {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: var(--wt-btn-radius);
    border: 1px solid rgba(255, 255, 255, 0.55);
  }

  .wt-hero__price {
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.015em;
  }

  /* ---------- hero: side cards ---------- */
  .wt-hero__card {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    min-height: 270px;
    display: flex;
    text-decoration: none;
  }

  .wt-hero__card.wt-hero__card--dark {
    background: var(--wt-ink);
  }

  .wt-hero__card-overlay {
    position: relative;
    pointer-events: none;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.92) 0%,
      rgba(16, 16, 18, 0.78) 60%,
      rgba(16, 16, 18, 0) 100%
    );
    width: 100%;
  }

  .wt-hero__card-title {
    margin: 0 0 8px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    color: #fff;
  }

  .wt-hero__card-copy {
    margin: 0;
    font-size: 15px;
    color: #fff;
    opacity: 0.92;
  }

  /* ---------- shared: eyebrow + primary button ---------- */
  .wt-hero__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }

  .wt-hero__eyebrow.wt-hero__eyebrow--feature {
    margin-bottom: 10px;
  }

  /* ---------- shared: contain-fit media fill ---------- */
  /* Six image hooks across five blocks with identical fill. Kept as
     separate class names so any one of them can diverge later, but
     sharing a single rule until one does.

     .wt-play__img is deliberately NOT here: it pads 10%, not 8%.
     .wt-knead__img is not here either: it fills with object-fit
     cover, not contain. */
  .wt-new__img,
  .wt-flavour__img,
  .wt-knead__tile-img,
  .wt-tagd__img,
  .wt-tagd__card-img,
  .wt-bubble__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
  }

  .wt-btn {
    background: var(--wt-red);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    padding: 15px 26px;
    border-radius: var(--wt-btn-radius);
  }

  .wt-btn--nowrap {
    white-space: nowrap;
  }

  /* ============================================================
     "Just landed" band  (#new)
     Section padding matches the .wt-section defaults, so there is
     no --wt-section-pad-* override here.
     ============================================================ */
  .wt-new {
    --wt-new-media-width: 340px;
    --wt-new-gap: 32px;
  }

  .wt-new__card {
    display: grid;
    grid-template-columns: var(--wt-new-media-width) 1fr auto;
    gap: var(--wt-new-gap);
    align-items: center;
    background: #fff;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-card-radius);
    overflow: hidden;
  }

  /* .wt-bubble__media shares this rule exactly (see the bubble card
     block below). */
  .wt-new__media,
  .wt-bubble__media {
    position: relative;
    aspect-ratio: 16/11;
    background: var(--wt-mist);
  }

  .wt-new__body {
    padding: 26px 0;
  }

  .wt-new__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-new__title {
    margin: 0 0 10px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 38px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-new__copy {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 52ch;
  }

  .wt-new__buy {
    padding: 26px 32px 26px 0;
    display: grid;
    gap: 14px;
    justify-items: end;
  }

  .wt-new__price {
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  /* ============================================================
     "Pick a flavour" three-card row
     Per-section token overrides must stay AFTER .wt-section —
     same specificity, so source order decides the winner.
     ============================================================ */
  .wt-section.wt-flavour {
    --wt-section-pad-top: 40px; /* .wt-section default is 32px */
    --wt-flavour-gap: 24px;
    --wt-flavour-radius: 10px;
  }

  .wt-flavour__heading {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wt-muted);
  }

  .wt-flavour__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--wt-flavour-gap);
  }

  /* Inert on the two <div> cards (these are div defaults); carries
     the link reset on the sushi <a>. Applied to all three so the
     cards stay stylable as one set. */
  .wt-flavour__card {
    text-decoration: none;
    color: inherit;
  }

  .wt-flavour__media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-flavour-radius);
    overflow: hidden;
    background: var(--wt-mist);
    margin-bottom: 12px;
  }

  .wt-flavour__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--wt-ink);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .wt-flavour__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }

  .wt-flavour__name {
    font-weight: 500;
    font-size: 16px;
  }

  .wt-flavour__price {
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .wt-flavour__meta {
    font-size: 13px;
    color: var(--wt-muted);
  }
  /* ============================================================
     "Nine to find" band  (#knead)
     ============================================================ */
  .wt-section.wt-knead {
    --wt-section-pad-top: 64px; /* .wt-section default is 32px */

    --wt-knead-gap: 56px;
    --wt-knead-tile-radius: 8px;
  }

  .wt-knead__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--wt-knead-gap);
    align-items: center;
  }

  .wt-knead__frame {
    background: var(--wt-mist);
    border-radius: var(--wt-card-radius);
    padding: 16px;
  }

  .wt-knead__media {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: var(--wt-knead-tile-radius);
    overflow: hidden;
  }

  .wt-knead__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wt-knead__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-knead__title {
    margin: 0 0 16px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-knead__body {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 46ch;
  }

  .wt-knead__styles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 26px;
  }

  .wt-knead__tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-knead-tile-radius);
    overflow: hidden;
    background: var(--wt-mist);
  }

  .wt-knead__tile--chase {
    border: 2px solid var(--wt-red);
  }

  .wt-knead__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .wt-knead__chase {
    aspect-ratio: 1;
    border-radius: var(--wt-knead-tile-radius);
    background: var(--wt-ink);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6px;
  }

  .wt-knead__chase-name {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .wt-knead__chase-meta {
    font-size: 10px;
    color: var(--wt-faint);
  }
  /* ============================================================
     "Endless bubble wrap" band  (#bubble)
     Full-bleed tint: the <section> spans the full width and carries
     the background, while .wt-bubble__inner holds the usual
     .wt-section measure and padding.

     The padding override is written as .wt-section.wt-bubble__inner
     so it outranks .wt-section on specificity, not on source order.

     .wt-bubble sits outside .wt-section but inside .wt-home, so the
     shared palette resolves on it directly.
     ============================================================ */
  .wt-bubble {
    --wt-bubble-swatch-size: 26px;

    background: var(--wt-mist);
    margin-top: 64px;
  }

  .wt-section.wt-bubble__inner {
    --wt-section-pad-top: 64px;
    --wt-section-pad-bottom: 64px;
  }

  .wt-bubble__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .wt-bubble__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-bubble__title {
    margin: 0;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-bubble__lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 44ch;
  }
  /* ============================================================
     "Tag'd 2" band  (#tagd)
     Compound selector on the section so the padding override
     outranks .wt-section on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-tagd {
    --wt-section-pad-top: 72px; /* .wt-section default is 32px */

    --wt-tagd-gap: 56px;
    --wt-tagd-step-size: 26px;
    --wt-tagd-card-radius: 10px;
  }

  .wt-tagd__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--wt-tagd-gap);
    align-items: center;
  }

  .wt-tagd__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-tagd__title {
    margin: 0 0 16px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-tagd__body {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 46ch;
  }

  /* ---------- tag'd: numbered steps ---------- */
  .wt-tagd__steps {
    display: grid;
    gap: 14px;
    margin-bottom: 28px;
    max-width: 44ch;
  }

  .wt-tagd__step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .wt-tagd__step-num {
    flex: 0 0 auto;
    width: var(--wt-tagd-step-size);
    height: var(--wt-tagd-step-size);
    border-radius: 999px;
    background: var(--wt-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wt-tagd__step-num.wt-tagd__step-num--accent {
    background: var(--wt-red);
  }

  .wt-tagd__step-text {
    font-size: 15px;
    line-height: 1.5;
  }

  .wt-tagd__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* ---------- tag'd: feature image ---------- */
  .wt-tagd__media {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-ink);
    aspect-ratio: 4/3;
  }

  /* ---------- tag'd: collection row ---------- */
  .wt-tagd__row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .wt-tagd__card {
    text-decoration: none;
    color: inherit;
  }

  .wt-tagd__card-media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-tagd-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    margin-bottom: 10px;
  }

  .wt-tagd__card-name {
    font-size: 14px;
    font-weight: 500;
  }
  /* ============================================================
     Trust row  (#trust)
     Compound selector on the section so the padding override
     outranks .wt-section on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-trust {
    --wt-section-pad-top: 64px;    /* .wt-section default is 32px */
    --wt-section-pad-bottom: 64px; /* .wt-section default is 8px */
  }

  .wt-trust__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    border-top: 1px solid var(--wt-line);
    padding-top: 40px;
  }

  .wt-trust__title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
  }

  .wt-trust__copy {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--wt-muted);
  }

  /* Compound so it beats the base rule's margin shorthand on
     specificity rather than on source order. */
  .wt-trust__copy.wt-trust__copy--spaced {
    margin-bottom: 8px;
  }

  .wt-trust__link {
    font-size: 15px;
    font-weight: 600;
    color: var(--wt-red);
  }
  /* ============================================================
     Newsletter band  (#newsletter)
     Full-bleed tint like #bubble: the <section> spans the full width
     and carries the background, while .wt-newsletter__inner holds
     the measure. This band is narrower than the rest of the page, so
     it overrides --wt-section-max as well as the padding.

     Compound selector so those overrides outrank .wt-section on
     specificity, not on source order.
     ============================================================ */
  .wt-newsletter {
    background: var(--wt-mist);
  }

  .wt-section.wt-newsletter__inner {
    --wt-section-max: 900px;       /* .wt-section default is 1400px */
    --wt-section-pad-top: 64px;    /* .wt-section default is 32px */
    --wt-section-pad-bottom: 64px; /* .wt-section default is 8px */

    text-align: center;
  }

  .wt-newsletter__title {
    margin: 0 0 12px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-newsletter__lead {
    margin: 0 0 24px;
    font-size: 16px;
    color: var(--wt-muted);
  }

  .wt-newsletter__success {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--wt-ink);
  }

  .wt-newsletter__form {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Form controls do not inherit font-family, so these two set it
     explicitly. The stack is kept exactly as it was inline; note it
     is shorter than --wt-font-body. */
  .wt-newsletter__input {
    font-family: 'Archivo', sans-serif;
    font-size: 16px;
    padding: 14px 16px;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-btn-radius);
    min-width: 300px;
    background: #fff;
  }

  /* Close to .wt-btn but not identical: 14px vertical padding rather
     than 15px, plus border/cursor resets. Kept separate rather than
     layered on .wt-btn with overrides. */
  .wt-newsletter__submit {
    font-family: 'Archivo', sans-serif;
    background: var(--wt-red);
    color: #fff;
    border: none;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 26px;
    border-radius: var(--wt-btn-radius);
    cursor: pointer;
  }
  /* ============================================================
     Bubble product cards  (snippets/wt-bubble.liquid)
     The snippet is rendered only from #bubble, so its rules live in
     this stylesheet rather than one of their own -- that keeps the
     .wt-home tokens in scope for it.

     .wt-bubble__media and .wt-bubble__img are not defined here: they
     match existing rules exactly and are joined to those selector
     lists above instead of being duplicated.
     ============================================================ */
  .wt-bubble__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .wt-bubble__card {
    background: #fff;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-card-radius);
    overflow: hidden;
  }

  .wt-bubble__body {
    padding: 26px;
  }

  .wt-bubble__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .wt-bubble__name {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.008em;
  }

  .wt-bubble__price {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .wt-bubble__copy {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--wt-muted);
  }

  /* ---------- bubble: colour swatches ---------- */
  .wt-bubble__swatches {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
  }

  /* The base sets no background, so the colour modifiers below have
     no property to fight over and need no compound selector. */
  .wt-bubble__swatch {
    width: var(--wt-bubble-swatch-size);
    height: var(--wt-bubble-swatch-size);
    border-radius: 999px;
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--wt-line);
  }

  .wt-bubble__swatch--red    { background: var(--wt-red); }
  .wt-bubble__swatch--ink    { background: var(--wt-ink); }
  .wt-bubble__swatch--pink   { background: #E0218A; }
  .wt-bubble__swatch--sky    { background: #00A3E0; }
  .wt-bubble__swatch--blue   { background: #1C4FD8; }
  .wt-bubble__swatch--green  { background: #2FA84F; }
  .wt-bubble__swatch--violet { background: #7A4FD8; }
  .wt-bubble__swatch--orange { background: #F07000; }
  .wt-bubble__swatch--yellow { background: #EFD400; }

  .wt-bubble__swatch-note {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    color: var(--wt-muted);
    font-weight: 600;
  }

  /* Close to .wt-btn but inline-block with 14px/24px padding, so it
     stays a separate rule rather than .wt-btn plus overrides. */
  .wt-bubble__cta {
    display: inline-block;
    background: var(--wt-red);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: var(--wt-btn-radius);
  }
  /* ============================================================
     "How do you want to play?" grid
     (snippets/wt-play.liquid, rendered as #more)
     The snippet is rendered only from this section file and lands
     inside .wt-home, so its rules live here and the shared tokens
     resolve for it.

     Compound selector so the padding override outranks .wt-section
     on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-play {
    --wt-section-pad-top: 72px; /* .wt-section default is 32px */

    --wt-play-media-radius: 12px;
  }

  .wt-play__title {
    margin: 0 0 8px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-play__lead {
    margin: 0 0 28px;
    font-size: 16px;
    color: var(--wt-muted);
  }

  .wt-play__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .wt-play__card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .wt-play__media {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: var(--wt-play-media-radius);
    overflow: hidden;
    background: var(--wt-mist);
  }

  /* Padded 10%, not the 8% the other contain-fit images use, so this
     deliberately does not join that shared rule. */
  .wt-play__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10%;
  }

  .wt-play__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wt-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Stops differ from the hero overlays (0.9/0.6 at 55%), so this is
     its own gradient rather than a shared one. */
  .wt-play__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    background: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.9) 0%,
      rgba(16, 16, 18, 0.6) 55%,
      rgba(16, 16, 18, 0) 100%
    );
  }

  .wt-play__verb {
    display: block;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    color: #fff;
  }

  .wt-play__sub {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    color: #fff;
    opacity: 0.85;
  }
  /* ============================================================
     Shared image fill  (snippets/wt-img.liquid)
     Rendered from this section and from wt-bubble, both of which sit
     inside .wt-home, so the shared tokens resolve for it.

     The fit mode used to be interpolated straight into the inline
     style; it is now a modifier class. Only 'cover' and 'contain'
     have rules -- the two values the call sites use. A different
     value would leave object-fit unset rather than passing through.

     The base sets no object-fit, so the modifiers have no property
     to fight over and need no compound selector.
     ============================================================ */
  .wt-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wt-img--cover {
    object-fit: cover;
  }

  .wt-img--contain {
    object-fit: contain;
    padding: 8%;
  }

  /* Same idea as .wt-play__placeholder, but with a background, inner
     padding and centred text, so it stays a separate rule. */
  .wt-img__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 14px;
    background: var(--wt-mist);
    color: var(--wt-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  /* ============================================================
     Mobile
     Everything above is the desktop layout and is left untouched;
     this block only narrows things below 768px.

     Note on specificity: a media query adds none. Where a desktop
     rule uses a compound selector, the mobile override has to
     repeat that compound form or it will lose the cascade.
     ============================================================ */
  @media (max-width: 767px) {
    /* The desktop track list starts with a hard 340px, which alone
       overflows a 375px viewport's content box. Stacking removes it. */
    .wt-new__card {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}
