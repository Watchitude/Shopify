</section> </div> {% schema %} { "name": "Watchitude home", "settings": [ { "type": "header", "content": "Photos still needed" }, { "type": "image_picker", "id": "hero_image", "label": "Hero image (defaults to sushi product photo)" }, { "type": "image_picker", "id": "ice_image", "label": "Knead That Ice Cream art" }, { "type": "image_picker", "id": "burger_image", "label": "Knead That Burger art" }, { "type": "image_picker", "id": "twogo_image", "label": "Endless Bubble 2Go (falls back to product photo)" }, { "type": "image_picker", "id": "new_image", "label": "Click-Key Blocks (SKU 740)" }, { "type": "image_picker", "id": "sushi_image", "label": "Sushi Blocks (SKU 565)" }, { "type": "image_picker", "id": "ice_blocks_image", "label": "Ice Cream Blocks (SKU 568)" }, { "type": "header", "content": "Just landed bands" }, { "type": "textarea", "id": "new_copy", "label": "Click-Key Blocks description", "default": "Clicky mechanical keys you can pull apart and snap back together. Quiet enough for the classroom, loud enough to be worth it." }, { "type": "textarea", "id": "sushi_copy", "label": "Sushi Blocks description", "default": "Magnetic blocks that snap into rolls, towers, and a sushi train as long as the floor. Forty-eight to collect, two to a bag, and one of them is rare." }, { "type": "textarea", "id": "blocks_lead", "label": "Blocks band intro", "default": "Collectible kinetic blocks \u2014 twist them, click them, stack them. Two to a sealed bag, so what you get is a surprise." }, { "type": "textarea", "id": "ice_blocks_copy", "label": "Ice Cream Blocks description", "default": "The same blocks in scoops and cones — twist them, click them, stack them into a sundae. Eighteen flavours to collect, two to a bag, and the bag is sealed." } ], "presets": [{ "name": "Watchitude home" }] } {% endschema %}

{% stylesheet %}
  /* ============================================================
     Watchitude home
     Tunable tokens live here. Adjust these, not the rules below.

     The shared palette lives on .wt-home, the template's outermost
     wrapper, so it resolves for every descendant regardless of
     nesting -- including elements outside a .wt-section, such as the
     full-bleed .wt-bubble band.

     The --wt-section-* geometry tokens deliberately stay on
     .wt-section: they are that class's own contract, no descendant
     reads them, and keeping them there means .wt-section still works
     standalone if it is ever used outside this template.

     Both scopes are class-scoped, so nothing leaks globally even
     though this CSS is bundled into the shared styles.css.
     ============================================================ */

  .wt-home {
    --wt-font-body: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    --wt-font-display: 'Jost', 'Century Gothic', Futura, sans-serif;

    --wt-red: #D71920;
    --wt-red-dark: #B3151B; /* --wt-red at 84%, the button hover shade */
    --wt-ink: #101012;
    --wt-mist: #F4F4F5;
    --wt-line: #E2E2E4;
    --wt-muted: #5A5A61;
    --wt-faint: #9a9aa2;

    --wt-card-radius: 14px;
    --wt-card-gap: 20px;
    --wt-btn-radius: 6px;

    /* Scrim behind the feature overlay. */
    --wt-hero-scrim: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.92) 0%,
      rgba(16, 16, 18, 0.62) 45%,
      rgba(16, 16, 18, 0.28) 72%,
      rgba(16, 16, 18, 0) 100%
    );

    /* The same ramp at 70% strength, for the two side cards. Their copy
       is shorter and sits over less of the image than the feature's
       does, so the full-strength scrim buried the art. Every stop is the
       one above multiplied by 0.7; the geometry is deliberately
       identical, so the two read as one treatment at two weights. */
    --wt-hero-scrim-soft: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.64) 0%,
      rgba(16, 16, 18, 0.43) 45%,
      rgba(16, 16, 18, 0.2) 72%,
      rgba(16, 16, 18, 0) 100%
    );

    font-family: var(--wt-font-body);
    color: var(--wt-ink);
    background: #fff;
  }
  .wt-section {
    --wt-section-max: 1400px;
    --wt-section-pad-x: 32px;
    --wt-section-pad-top: 32px;
    --wt-section-pad-bottom: 8px;

    max-width: var(--wt-section-max);
    margin: 0 auto;
    padding: var(--wt-section-pad-top) var(--wt-section-pad-x) var(--wt-section-pad-bottom);
  }

  /* ---------- hero: layout ---------- */
  .wt-hero__grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--wt-card-gap);
    align-items: stretch;
  }

  .wt-hero__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--wt-card-gap);
  }

  /* ---------- hero: shared media layer ---------- */
  .wt-hero__media {
    position: absolute;
    inset: 0;
  }

  .wt-hero__media--dim {
    opacity: 0.85;
  }

  .wt-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- hero: image switcher ---------- */
  /* Two blocks switch images this way: the feature's three flavours and
     the endless bubble card's two sizes. The images stack in the block's
     own .wt-hero__media and cross-fade on opacity -- nothing swaps src,
     so a switch never waits on the network -- and each block names the
     one showing in its own data-wt-option. The tag'd card carries no
     such attribute, so its .wt-hero__img is untouched by all of this. */
  .wt-hero__img--switch {
    opacity: 0;
    transition: opacity 200ms ease;
  }

  /* Two jobs in one rule for the ice cream shot. It is squarer than the
     panel, so the shared cover blew it up until the cone was cropped;
     sizing the element to the image instead -- full height, natural
     width, centred -- fits the whole photo the way object-fit: contain
     did. And that is also what puts the element's edges on the photo's
     edges, so the clip-path below takes its 10px off the right of the
     picture rather than off the white beside it. object-view-box would
     crop the source in one line, but Firefox still does not support it.

     A source wider than the panel would crop at the sides rather than
     fit; the flavour shots so far are all squarer than that. */
  .wt-hero__img--ice {
    inset: 0 auto 0 50%;
    width: auto;
    height: 100%;
    transform: translateX(-50%);
    clip-path: inset(0 10px 0 0);
  }

  /* Cover fills the panel by definition, so pulling the sushi shot back
     10% means it no longer reaches the edges: a 5% band of panel shows
     all round. Scaling the element rather than padding it keeps the crop
     exactly as it was framed, just smaller. */
  .wt-hero__img--sushi {
    transform: scale(0.9);
  }

  /* Both bubble sizes are square transparent cut-outs, so the shared
     cover would crop the product's top and bottom against a landscape
     card. Contain fits each one whole; the card's mist shows through
     the transparency behind it. */
  .wt-hero__img--full,
  .wt-hero__img--2go {
    object-fit: contain;
  }

  /* The burger placeholder is a 342px near-square, so cover would both
     crop it and blow it up; contain at least keeps all of it on screen
     until the real art arrives. */
  .wt-hero__img--burger {
    object-fit: contain;
  }

  /* One <h1> whose last word changes with the flavour. display, not
     opacity: a hidden word has to be gone from the accessibility tree
     too, or the heading reads as "knead that sushi ice cream burger". */
  .wt-hero__title-word {
    display: none;
  }

  .wt-hero__feature[data-wt-option='sushi'] .wt-hero__title-word--sushi,
  .wt-hero__feature[data-wt-option='ice'] .wt-hero__title-word--ice,
  .wt-hero__feature[data-wt-option='burger'] .wt-hero__title-word--burger {
    display: inline;
  }

  /* One pair per slide, capped at the nine the loops render -- nine
     being the whole tag'd collection today. An index cannot be matched
     between parent and child in CSS the way a name can, and Liquid is
     not rendered inside a stylesheet tag, so these cannot be generated
     from the collection the way the dots are. A tenth style needs a
     tenth pair here and a tenth in the block below it. */
  .wt-hero__card[data-wt-option='0'] .wt-hero__img--tagd-0,
  .wt-hero__card[data-wt-option='1'] .wt-hero__img--tagd-1,
  .wt-hero__card[data-wt-option='2'] .wt-hero__img--tagd-2,
  .wt-hero__card[data-wt-option='3'] .wt-hero__img--tagd-3,
  .wt-hero__card[data-wt-option='4'] .wt-hero__img--tagd-4,
  .wt-hero__card[data-wt-option='5'] .wt-hero__img--tagd-5,
  .wt-hero__card[data-wt-option='6'] .wt-hero__img--tagd-6,
  .wt-hero__card[data-wt-option='7'] .wt-hero__img--tagd-7,
  .wt-hero__card[data-wt-option='8'] .wt-hero__img--tagd-8 {
    opacity: 1;
  }

  /* The style name under the dots, swapped the same way and for the
     same reason as the flavour word in the feature's heading: display
     rather than opacity, so the eight names that are not showing are
     out of the accessibility tree rather than merely invisible. */
  .wt-hero__style-word {
    display: none;
  }

  .wt-hero__card[data-wt-option='0'] .wt-hero__style-word--0,
  .wt-hero__card[data-wt-option='1'] .wt-hero__style-word--1,
  .wt-hero__card[data-wt-option='2'] .wt-hero__style-word--2,
  .wt-hero__card[data-wt-option='3'] .wt-hero__style-word--3,
  .wt-hero__card[data-wt-option='4'] .wt-hero__style-word--4,
  .wt-hero__card[data-wt-option='5'] .wt-hero__style-word--5,
  .wt-hero__card[data-wt-option='6'] .wt-hero__style-word--6,
  .wt-hero__card[data-wt-option='7'] .wt-hero__style-word--7,
  .wt-hero__card[data-wt-option='8'] .wt-hero__style-word--8 {
    display: inline;
  }

  .wt-hero__feature[data-wt-option='sushi'] .wt-hero__img--sushi,
  .wt-hero__feature[data-wt-option='ice'] .wt-hero__img--ice,
  .wt-hero__feature[data-wt-option='burger'] .wt-hero__img--burger,
  .wt-hero__card[data-wt-option='full'] .wt-hero__img--full,
  .wt-hero__card[data-wt-option='2go'] .wt-hero__img--2go {
    opacity: 1;
  }

  /* ---------- hero: feature panel ---------- */
  /* White rather than the --wt-mist the other panels use: none of the
     three flavour shots reaches the edges any more -- ice cream and
     burger are contained, sushi is scaled back to 90% -- so the panel
     shows around each one and has to be the white the photos are shot
     on, or the seam shows. It is the same white for every flavour, which
     is why this sits on the panel rather than on each state. */
  .wt-hero__feature {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: #fff;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .wt-hero__overlay {
    position: relative;
    pointer-events: none;
    padding: 40px;
    background: var(--wt-hero-scrim);
  }

  .wt-hero__title {
    margin: 0 0 14px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(38px, 9vw, 64px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
    color: #fff;
    text-shadow: 0 1px 12px rgba(16, 16, 18, 0.5);
    max-width: 15ch;
  }

  .wt-hero__lead {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.5;
    color: #fff;
    text-shadow: 0 1px 12px rgba(16, 16, 18, 0.5);
    max-width: 46ch;
    opacity: 0.92;
  }

  .wt-hero__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .wt-hero__pills {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* One class over three elements: <a> for Sushi, <button> for a flavour
     that has art, <span> for one that does not. The resets are what keep
     them looking identical whichever it is. */
  .wt-hero__pill {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-family: inherit;
    font-weight: 600;
    font-size: 16px;
    line-height: inherit;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: var(--wt-btn-radius);
    border: 1px solid rgba(255, 255, 255, 0.55);
    appearance: none;
    -webkit-appearance: none;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  /* The attribute is the switcher's own hook, so this styles exactly the
     pills that do something when clicked. */
  .wt-hero__pill[data-wt-option] {
    cursor: pointer;
  }

  .wt-hero__pill.wt-hero__pill--active {
    background: #fff;
    border-color: #fff;
    color: var(--wt-ink);
  }

  .wt-hero__pill:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* A dot is a pill with the label taken out: six product names would
     never fit a 270px card. The 22px box with 6px of padding is what
     gives a 10px dot a hit area worth tapping -- background-clip is what
     keeps the paint on the inner 10px. Which also means the rules below
     set background-color, never the background shorthand, since the
     shorthand would reset the clip back to the border box. */
  .wt-hero__pills.wt-hero__pills--dots {
    gap: 10px;
  }

  .wt-hero__pill.wt-hero__pill--dot {
    width: 22px;
    height: 22px;
    padding: 6px;
    border: 0;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.4);
    background-clip: content-box;
  }

  .wt-hero__pill.wt-hero__pill--dot.wt-hero__pill--active {
    background-color: #fff;
    background-clip: content-box;
  }

  /* Dots at one end of the card's last line, button at the other.

     Lifted over .wt-hero__card-link::after and handed pointer-events
     back from the overlay, both of which the dot row used to do for
     itself -- the row it now sits in does it for the pair, so a click on
     either stays where it landed instead of following the card.

     margin-left on the button rather than justify-content on the row:
     the two agree while everything fits on one line, and only the margin
     keeps the button to the right once nine dots and a button no longer
     do. */
  .wt-hero__controls {
    position: relative;
    z-index: 1;
    pointer-events: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .wt-hero__controls .wt-btn {
    margin-left: auto;
  }

  /* The dots bring the 14px they need when they follow the copy
     directly, as they do on the bubble card. In here the row above owns
     that gap, so they give it back. Compound selector so it outranks
     .wt-hero__pills--compact on specificity, not on source order. */
  .wt-hero__controls .wt-hero__pills.wt-hero__pills--compact {
    margin-top: 0;
  }

  /* The same button as #knead's, sized for a 270px card -- the drop from
     16px to 14px is the one .wt-hero__pill--compact already makes for
     the same reason. */
  .wt-btn.wt-btn--compact {
    display: inline-block;
    font-size: 14px;
    padding: 11px 18px;
  }

  /* ---------- tag'd hero: the next-style caret ----------
     Against the card's right edge and centred on the photo, where a
     carousel arrow is looked for, rather than tacked onto the end of the
     dot row. The dots say which of the nine is showing; this only says
     "another one", so it does not need to sit among them.

     z-index over .wt-hero__card-link::after, which is stretched across
     the whole card: without it a click here would follow the card to the
     collection instead of turning the watch over. The dots buy the same
     lift a few rules up. */
  .wt-hero__next {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  /* The chevron itself: two borders of an empty box, turned 45 degrees.
     It is drawn rather than set as a character because the glyph that
     would do it varies by font, and this card's font stack is a
     webfont with a system fallback -- the fallback would move it.

     Turning a square leaves its ink right of the box's centre, so the
     box is nudged back by the 2px the border adds. */
  .wt-hero__next::before {
    content: '';
    width: 10px;
    height: 10px;
    margin-left: -2px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
  }

  .wt-hero__next:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: #fff;
  }

  .wt-hero__next:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wt-hero__img--switch,
    .wt-hero__pill,
    .wt-hero__next {
      transition: none;
    }
  }

  .wt-hero__price {
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.015em;
  }

  /* ---------- hero: side cards ---------- */
  .wt-hero__card {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    min-height: 270px;
    display: flex;
    text-decoration: none;
  }

  .wt-hero__card.wt-hero__card--dark {
    background: var(--wt-ink);
  }

  /* The bubble card stopped being one big <a> when the pills went into
     it: a button inside a link is not something a browser will parse.
     The title's link is stretched across the whole card instead, so the
     card still clicks through anywhere, and the accessible name stays
     the words in the title rather than a wrapper full of everything.

     pointer-events has to be handed back explicitly -- .wt-hero__card-
     overlay turns it off for the whole overlay, which is what stops the
     scrim from eating clicks. */
  .wt-hero__card-link {
    color: inherit;
    text-decoration: none;
    pointer-events: auto;
  }

  .wt-hero__card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Same pills as the feature, sized down for a 270px card, and lifted
     over the stretched link so a tap on one switches the image instead
     of following the card. */
  .wt-hero__pills.wt-hero__pills--compact {
    position: relative;
    z-index: 1;
    gap: 8px;
    margin-top: 14px;
    pointer-events: auto;
  }

  .wt-hero__pill.wt-hero__pill--compact {
    font-size: 13px;
    padding: 8px 14px;
  }

  .wt-hero__card-overlay {
    position: relative;
    pointer-events: none;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--wt-hero-scrim-soft);
    width: 100%;
  }

  .wt-hero__card-title {
    margin: 0 0 8px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(24px, 5vw, 34px);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    color: #fff;
  }

  .wt-hero__card-copy {
    margin: 0;
    font-size: 15px;
    color: #fff;
    opacity: 0.92;
  }

  /* The name of whichever style is showing, between the copy and the
     dots that change it. Full white against the card-copy's 0.92, so
     the line that moves reads as the live one and the pitch above it
     stays the quieter of the two. */
  .wt-hero__style {
    position: relative;
    margin: 12px 0 0;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }

  /* The controls carry 14px of their own, which under the style name is
     one gap too many, so it is taken back here. The dot row used to be
     what followed the name; it is the row around it now. */
  .wt-hero__style + .wt-hero__controls {
    margin-top: 8px;
  }

  /* ---------- shared: eyebrow + primary button ---------- */
  .wt-hero__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 12px rgba(16, 16, 18, 0.5);
  }

  .wt-hero__eyebrow.wt-hero__eyebrow--feature {
    margin-bottom: 10px;
  }

  /* ---------- shared: contain-fit media fill ---------- */
  /* Five image hooks across four blocks with identical fill. Kept as
     separate class names so any one of them can diverge later, but
     sharing a single rule until one does.

     .wt-play__img is deliberately NOT here: it pads 10%, not 8%.
     .wt-knead__img is not here either: it fills with object-fit
     cover, not contain. Nor is .wt-knead__tile-img: the character
     art arrives pre-framed, so it pads 0. Nor .wt-tagd__img, which
     covers its panel -- .wt-tagd__card-img, the thumbnail of the same
     photograph, still fits and pads and so is still here. */
  .wt-new__img,
  .wt-flavour__img,
  .wt-tagd__card-img,
  .wt-bubble__img,
  .wt-blocks__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8%;
  }

  .wt-btn {
    background: var(--wt-red);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    padding: 15px 26px;
    border-radius: var(--wt-btn-radius);
  }

  .wt-btn--nowrap {
    white-space: nowrap;
  }

  /* ---------- shared: red button hover ---------- */
  /* The three red buttons in one rule. They are separate classes
     because their padding differs -- .wt-btn sits at 15px, the
     newsletter submit at 14px, the bubble cta at 14px/24px -- and each
     rule above says so. None of that changes what a pointer on one
     should do, so the answer to that is written once.

     Nothing else needs adding here: .wt-btn--compact and the copy of
     .wt-btn inside .wt-hero__controls are both .wt-btn with the sizing
     changed, so they are already in.

     The lift is the .wt-bubble__swatch gesture at button scale -- rise
     and take a shadow -- but at the 200ms the pills and the caret use
     rather than the swatch's 0.12s. A 40px dot growing by a third
     wants to be quick; a button moving 2px at the same speed reads as
     a flinch.

     Red shadow rather than black because these buttons land on three
     grounds: white, --wt-mist, and the tag'd card's photo. A black
     shadow disappears against the last one, and a tint of the button's
     own colour reads on all three.

     :focus-visible gets the same treatment, so the gesture is not
     something only a pointer can see. */
  .wt-btn,
  .wt-newsletter__submit,
  .wt-bubble__cta,
  .wt-blocks__cta {
    transition: background-color 200ms ease, transform 200ms ease,
      box-shadow 200ms ease;
  }

  .wt-btn:is(:hover, :focus-visible),
  .wt-newsletter__submit:is(:hover, :focus-visible),
  .wt-bubble__cta:is(:hover, :focus-visible),
  .wt-blocks__cta:is(:hover, :focus-visible) {
    background: var(--wt-red-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(215, 25, 32, 0.32);
  }

  /* Pressed puts it back on the ground, under the pointer that pushed
     it. Without this the button stays lifted through the click and the
     press has no moment of its own. */
  .wt-btn:active,
  .wt-newsletter__submit:active,
  .wt-bubble__cta:active,
  .wt-blocks__cta:active {
    transform: translateY(0);
    box-shadow: none;
  }

  /* The darkening stays -- it is the part that says the button is under
     the pointer. Only the moving is dropped, the same trade the
     swatches make. */
  @media (prefers-reduced-motion: reduce) {
    .wt-btn,
    .wt-newsletter__submit,
    .wt-bubble__cta,
    .wt-blocks__cta {
      transition: background-color 200ms ease;
    }

    .wt-btn:is(:hover, :focus-visible),
    .wt-newsletter__submit:is(:hover, :focus-visible),
    .wt-bubble__cta:is(:hover, :focus-visible),
    .wt-blocks__cta:is(:hover, :focus-visible) {
      transform: none;
      box-shadow: none;
    }
  }

  /* ============================================================
     "Just landed" band  (#new)
     Section padding matches the .wt-section defaults, so there is
     no --wt-section-pad-* override here.

     The card markup lives in snippets/wt-new.liquid: the band is
     rendered once on this page now, in the #new band under the hero.
     It kept its parameters when the two blocks bands it also served
     merged into #blocks and took a card shape of their own.
     ============================================================ */
  .wt-new {
    --wt-new-media-width: 340px;
    --wt-new-gap: 32px;
  }

  .wt-new__card {
    display: grid;
    grid-template-columns: var(--wt-new-media-width) 1fr auto;
    gap: var(--wt-new-gap);
    align-items: center;
    background: #fff;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-card-radius);
    overflow: hidden;
  }

  /* .wt-bubble__media shares this rule exactly (see the bubble card
     block below). */
  .wt-new__media,
  .wt-bubble__media,
  .wt-blocks__media {
    position: relative;
    aspect-ratio: 16/11;
    background: var(--wt-mist);
  }

  .wt-new__body {
    padding: 26px 0;
  }

  .wt-new__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-new__title {
    margin: 0 0 10px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(28px, 6vw, 38px);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-new__copy {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 52ch;
  }

  .wt-new__buy {
    padding: 26px 32px 26px 0;
    display: grid;
    gap: 14px;
    justify-items: end;
  }

  .wt-new__price {
    font-weight: 700;
    font-size: clamp(22px, 4vw, 26px);
    letter-spacing: -0.02em;
  }

  /* ============================================================
     "Pick a flavour" three-card row
     Per-section token overrides must stay AFTER .wt-section —
     same specificity, so source order decides the winner.
     ============================================================ */
  .wt-section.wt-flavour {
    --wt-section-pad-top: 40px; /* .wt-section default is 32px */
    --wt-flavour-gap: 24px;
    --wt-flavour-radius: 10px;
  }

  .wt-flavour__heading {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wt-muted);
  }

  .wt-flavour__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--wt-flavour-gap);
  }

  /* Inert on the two <div> cards (these are div defaults); carries
     the link reset on the sushi <a>. Applied to all three so the
     cards stay stylable as one set. */
  .wt-flavour__card {
    text-decoration: none;
    color: inherit;
  }

  .wt-flavour__media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-flavour-radius);
    overflow: hidden;
    background: var(--wt-mist);
    margin-bottom: 12px;
  }

  .wt-flavour__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--wt-ink);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .wt-flavour__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }

  .wt-flavour__name {
    font-weight: 500;
    font-size: 16px;
  }

  .wt-flavour__price {
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .wt-blocks__meta,
  .wt-flavour__meta {
    font-size: 13px;
    color: var(--wt-muted);
  }
  /* ============================================================
     "Nine to find" band  (#knead)
     ============================================================ */
  .wt-section.wt-knead {
    --wt-section-pad-top: 64px; /* .wt-section default is 32px */

    --wt-knead-gap: 56px;
    --wt-knead-tile-radius: 8px;
  }

  .wt-knead__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--wt-knead-gap);
    align-items: center;
  }

  .wt-knead__frame {
    background: var(--wt-mist);
    border-radius: var(--wt-card-radius);
    padding: 16px;
  }

  .wt-knead__media {
    position: relative;
    aspect-ratio: 4/3;
    border-radius: var(--wt-knead-tile-radius);
    overflow: hidden;
  }

  .wt-knead__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wt-knead__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-knead__title {
    margin: 0 0 16px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(32px, 7.5vw, 52px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-knead__body {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 46ch;
  }

  .wt-knead__styles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 26px;
  }

  .wt-knead__tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-knead-tile-radius);
    overflow: hidden;
    background: var(--wt-mist);
  }

  /* The 300x300 character art is framed in the file itself, so it
     fills the tile edge to edge instead of taking the shared 8% pad.
     The height rule pairs with the width/height attributes: those
     reserve the square before load, this one keeps it square after
     the tile's width: 100% takes over. */
  .wt-knead__tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wt-knead__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  /* ============================================================
     "Blocks" band  (#blocks)
     Almost nothing of its own. The band is the head-plus-two-cards
     shape #bubble already had, so every rule it needs is one it joins
     rather than restates -- head, eyebrow, title, lead, cards, card,
     media, img, body, row, name, price, copy and cta, plus the meta
     line it borrows from the flavour cards. What is left is the two
     ways it differs: it keeps the page white where #bubble carries a
     mist tint, because the two bands are neighbours and a second tint
     would run them together, and it takes the deeper top padding the
     other headed bands use.

     Compound selector so the padding override outranks .wt-section on
     specificity, not on source order.
     ============================================================ */
  .wt-section.wt-blocks {
    --wt-section-pad-top: 72px; /* .wt-section default is 32px */
  }

  /* Sits between the name/price line and the copy, so it reads as a
     note on the price rather than a line of the description. */
  .wt-blocks__meta {
    display: block;
    margin-bottom: 10px;
  }

  /* The two buttons line up whatever sits above them. #bubble lives
     with its pair at different heights, and can: its two cards are a
     different size, a different price and a different length of copy,
     so nobody reads them as a matched pair. These two are the same
     product in two foods at the same price, close enough that a
     button an inch out reads as a mistake -- and the Coming soon line
     appears on one card and not the other, so they start out uneven
     by construction.

     Which is why the shared card and body rules are joined but not
     the whole of it: the card and its body become columns, and the
     button takes up whatever slack is left. align-self keeps the
     button its own width, since a flex item would otherwise stretch
     the full width of the body. */
  .wt-blocks__card {
    display: flex;
    flex-direction: column;
  }

  .wt-blocks__body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .wt-blocks__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* ============================================================
     "Endless bubble wrap" band  (#bubble)
     Full-bleed tint: the <section> spans the full width and carries
     the background, while .wt-bubble__inner holds the usual
     .wt-section measure and padding.

     The padding override is written as .wt-section.wt-bubble__inner
     so it outranks .wt-section on specificity, not on source order.

     .wt-bubble sits outside .wt-section but inside .wt-home, so the
     shared palette resolves on it directly.
     ============================================================ */
  .wt-bubble {
    --wt-bubble-swatch-size: 26px;
    /* The 2Go card's image swatches run smaller than the full-size
       card's colour dots: eighteen of them have to wrap into the
       same body width that six dots used to fill on one line. */
    --wt-bubble-swatch-img-size: 22px;
    --wt-bubble-swatch-img-gap: 6px;

    background: var(--wt-mist);
    margin-top: 64px;
  }

  .wt-section.wt-bubble__inner {
    --wt-section-pad-top: 64px;
    --wt-section-pad-bottom: 64px;
  }

  .wt-blocks__head,
  .wt-bubble__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .wt-blocks__eyebrow,
  .wt-bubble__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-blocks__title,
  .wt-bubble__title {
    margin: 0;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(32px, 7.5vw, 52px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-blocks__lead,
  .wt-bubble__lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 44ch;
  }
  /* ============================================================
     "Tag'd 2" band  (#tagd)
     Compound selector on the section so the padding override
     outranks .wt-section on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-tagd {
    --wt-section-pad-top: 72px; /* .wt-section default is 32px */

    --wt-tagd-gap: 56px;
    --wt-tagd-step-size: 26px;
    --wt-tagd-card-radius: 10px;
  }

  .wt-tagd__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--wt-tagd-gap);
    align-items: center;
  }

  .wt-tagd__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--wt-red);
  }

  .wt-tagd__title {
    margin: 0 0 16px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(32px, 7.5vw, 52px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .wt-tagd__body {
    margin: 0 0 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--wt-muted);
    max-width: 46ch;
  }

  /* ---------- tag'd: numbered steps ---------- */
  .wt-tagd__steps {
    display: grid;
    gap: 14px;
    margin-bottom: 28px;
    max-width: 44ch;
  }

  .wt-tagd__step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .wt-tagd__step-num {
    flex: 0 0 auto;
    width: var(--wt-tagd-step-size);
    height: var(--wt-tagd-step-size);
    border-radius: 999px;
    background: var(--wt-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wt-tagd__step-num.wt-tagd__step-num--accent {
    background: var(--wt-red);
  }

  .wt-tagd__step-text {
    font-size: 15px;
    line-height: 1.5;
  }

  .wt-tagd__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  /* ---------- tag'd: feature image ---------- */
  .wt-tagd__media {
    position: relative;
    border-radius: var(--wt-card-radius);
    overflow: hidden;
    background: var(--wt-ink);
    aspect-ratio: 4/3;
  }

  /* Cover, where every other photo in this stylesheet that sits on a
     panel is contained. The photos are square and the panel is 4/3, so
     fitting one left a third of the panel's width as bare --wt-ink
     either side of a small white square. Covering fills it: the crop
     takes about 12% off the top and bottom of the square, which is
     strap rather than watch -- the straps already run off the corners
     of the frame -- and the panel's ink stops showing at all.

     Which is why the ink stays on .wt-tagd__media above rather than
     coming out: it is what the corners paint against while the nine
     photos decode, and what the fallback single photo still sits on. */
  .wt-tagd__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- tag'd: hover preview ---------- */
  /* Hovering a style in the row shows it in the panel. Done in CSS
     rather than through the hero's switcher because there is no state
     to keep: the hero's pills have to tell a hover apart from a click,
     since a click there picks a style and has to survive the pointer
     leaving, but a click here is a link and just goes to the product.
     So the pointer is the whole of it, and :has lets the panel read a
     row that comes after it in the DOM.

     Index-keyed like the hero's slides, and fragile the same way -- a
     tenth style needs a tenth pair -- but harmless if the collection is
     reordered: nth-child(n) and --n both count the same collection in
     the same order, so they move together. */
  .wt-tagd__img--switch {
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .wt-tagd__img--0 {
    opacity: 1;
  }

  /* Gated on a real pointer. iOS treats the first tap on something with
     hover styles as the hover and the second as the click, which would
     cost the row's links a tap for a preview a touch device cannot see
     the point of. Keyboards come with pointers, so :focus-visible is
     inside the gate too and still reaches the people who need it. */
  @media (hover: hover) {
    .wt-tagd:has(.wt-tagd__card:is(:hover, :focus-visible)) .wt-tagd__img--0 {
      opacity: 0;
    }

    .wt-tagd:has(.wt-tagd__card:nth-child(1):is(:hover, :focus-visible)) .wt-tagd__img--0,
    .wt-tagd:has(.wt-tagd__card:nth-child(2):is(:hover, :focus-visible)) .wt-tagd__img--1,
    .wt-tagd:has(.wt-tagd__card:nth-child(3):is(:hover, :focus-visible)) .wt-tagd__img--2,
    .wt-tagd:has(.wt-tagd__card:nth-child(4):is(:hover, :focus-visible)) .wt-tagd__img--3,
    .wt-tagd:has(.wt-tagd__card:nth-child(5):is(:hover, :focus-visible)) .wt-tagd__img--4,
    .wt-tagd:has(.wt-tagd__card:nth-child(6):is(:hover, :focus-visible)) .wt-tagd__img--5,
    .wt-tagd:has(.wt-tagd__card:nth-child(7):is(:hover, :focus-visible)) .wt-tagd__img--6,
    .wt-tagd:has(.wt-tagd__card:nth-child(8):is(:hover, :focus-visible)) .wt-tagd__img--7,
    .wt-tagd:has(.wt-tagd__card:nth-child(9):is(:hover, :focus-visible)) .wt-tagd__img--8 {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wt-tagd__img--switch {
      transition: none;
    }
  }

  /* ---------- tag'd: collection row ---------- */
  /* Nine styles, nine columns, one row. At the section's full 1400px
     that is a 134px card, which is enough for a watch face and a name,
     and puts the whole collection in one glance -- the point of the row
     in the first place. */
  .wt-tagd__row {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .wt-tagd__card {
    text-decoration: none;
    color: inherit;
  }

  .wt-tagd__card-media {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--wt-tagd-card-radius);
    overflow: hidden;
    background: var(--wt-mist);
    margin-bottom: 10px;
  }

  .wt-tagd__card-name {
    font-size: 14px;
    font-weight: 500;
  }

  /* Below the full width, nine columns stop being cards and start being
     stamps -- and nine wraps to a ragged last row at every column count
     narrow enough to fit. So the row becomes a swipeable strip instead:
     same markup, same order, fixed-width cards, and the cut-off card at
     the right edge is what says there is more to the left and right.
     This is the only breakpoint between here and the 767px one, which
     leaves the strip in place on phones rather than re-gridding it. */
  @media (max-width: 1099px) {
    .wt-tagd__row {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 150px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      /* Room under the cards for the scrollbar the strip now needs, so
         it lands between the row and the section below it rather than
         on top of the names. */
      padding-bottom: 8px;
    }

    .wt-tagd__card {
      scroll-snap-align: start;
    }
  }
  /* ============================================================
     Trust row  (#trust)
     Compound selector on the section so the padding override
     outranks .wt-section on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-trust {
    --wt-section-pad-top: 64px;    /* .wt-section default is 32px */
    --wt-section-pad-bottom: 64px; /* .wt-section default is 8px */
  }

  .wt-trust__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    border-top: 1px solid var(--wt-line);
    padding-top: 40px;
  }

  .wt-trust__title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 600;
  }

  .wt-trust__copy {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--wt-muted);
  }

  /* Compound so it beats the base rule's margin shorthand on
     specificity rather than on source order. */
  .wt-trust__copy.wt-trust__copy--spaced {
    margin-bottom: 8px;
  }

  .wt-trust__link {
    font-size: 15px;
    font-weight: 600;
    color: var(--wt-red);
  }
  /* ============================================================
     Newsletter band  (#newsletter)
     Full-bleed tint like #bubble: the <section> spans the full width
     and carries the background, while .wt-newsletter__inner holds
     the measure. This band is narrower than the rest of the page, so
     it overrides --wt-section-max as well as the padding.

     Compound selector so those overrides outrank .wt-section on
     specificity, not on source order.
     ============================================================ */
  .wt-newsletter {
    background: var(--wt-mist);
  }

  .wt-section.wt-newsletter__inner {
    --wt-section-max: 900px;       /* .wt-section default is 1400px */
    --wt-section-pad-top: 64px;    /* .wt-section default is 32px */
    --wt-section-pad-bottom: 64px; /* .wt-section default is 8px */

    text-align: center;
  }

  .wt-newsletter__title {
    margin: 0 0 12px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(30px, 6.5vw, 40px);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-newsletter__lead {
    margin: 0 0 24px;
    font-size: 16px;
    color: var(--wt-muted);
  }

  .wt-newsletter__success {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--wt-ink);
  }

  .wt-newsletter__form {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Form controls do not inherit font-family, so these two set it
     explicitly. The stack is kept exactly as it was inline; note it
     is shorter than --wt-font-body. */
  .wt-newsletter__input {
    font-family: 'Archivo', sans-serif;
    font-size: 16px;
    padding: 14px 16px;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-btn-radius);
    min-width: 300px;
    background: #fff;
  }

  /* Close to .wt-btn but not identical: 14px vertical padding rather
     than 15px, plus border/cursor resets. Kept separate rather than
     layered on .wt-btn with overrides. */
  .wt-newsletter__submit {
    font-family: 'Archivo', sans-serif;
    background: var(--wt-red);
    color: #fff;
    border: none;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 26px;
    border-radius: var(--wt-btn-radius);
    cursor: pointer;
  }
  /* ============================================================
     Bubble product cards  (snippets/wt-bubble.liquid)
     The snippet is rendered only from #bubble, so its rules live in
     this stylesheet rather than one of their own -- that keeps the
     .wt-home tokens in scope for it.

     .wt-bubble__media and .wt-bubble__img are not defined here: they
     match existing rules exactly and are joined to those selector
     lists above instead of being duplicated.
     ============================================================ */
  .wt-blocks__cards,
  .wt-bubble__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .wt-blocks__card,
  .wt-bubble__card {
    background: #fff;
    border: 1px solid var(--wt-line);
    border-radius: var(--wt-card-radius);
    overflow: hidden;
  }

  .wt-blocks__body,
  .wt-bubble__body {
    padding: 26px;
  }

  .wt-blocks__row,
  .wt-bubble__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .wt-blocks__name,
  .wt-bubble__name {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.008em;
  }

  .wt-blocks__price,
  .wt-bubble__price {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.015em;
  }

  .wt-blocks__copy,
  .wt-bubble__copy {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--wt-muted);
  }

  /* ---------- bubble: colour swatches ---------- */
  .wt-bubble__swatches {
    display: flex;
    gap: 8px;
    margin-bottom: 22px;
  }

  /* The base sets no background, so the colour modifiers below have
     no property to fight over and need no compound selector. */
  .wt-bubble__swatch {
    width: var(--wt-bubble-swatch-size);
    height: var(--wt-bubble-swatch-size);
    border-radius: 999px;
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--wt-line);
  }

  /* Six modifiers, one per dot on the full-size card, which is now the
     only card using them. --ink, --orange and --yellow went with the
     2Go card's dots when it moved to image swatches. */
  .wt-bubble__swatch--red    { background: var(--wt-red); }
  .wt-bubble__swatch--pink   { background: #E0218A; }
  .wt-bubble__swatch--sky    { background: #00A3E0; }
  .wt-bubble__swatch--blue   { background: #1C4FD8; }
  .wt-bubble__swatch--green  { background: #2FA84F; }
  .wt-bubble__swatch--violet { background: #7A4FD8; }

  /* ---------- bubble: image swatches (2Go) ----------
     Scoped to the 2Go row rather than folded into the base, so the
     full-size card keeps its 26px dots, its 8px gap and its single
     unwrapped line. Only this row changes height. */
  .wt-bubble__swatches--images {
    flex-wrap: wrap;
    gap: var(--wt-bubble-swatch-img-gap);
  }

  /* img.<class> outranks the plain .wt-bubble__swatch base above, so
     these land on the 2Go images without touching the spans.

     The height here is the author rule the width/height attributes
     need: 96x96 attributes with only a CSS width would have the
     browser derive the height from the intrinsic ratio, which is the
     bug the two logos hit. Both axes are pinned, so there is nothing
     to derive. */
  img.wt-bubble__swatch {
    display: block;
    width: var(--wt-bubble-swatch-img-size);
    height: var(--wt-bubble-swatch-img-size);
    object-fit: cover;
    border-radius: 50%;
  }

  /* ---------- bubble: swatch hover (both cards) ----------
     Nothing in either row says it is hoverable until the pointer is on
     one, so the hover has to carry the whole affordance: the swatch
     lifts out of the row and takes a white ring, at the same beat as the
     photo above it changes. The two landing together is what reads as
     one gesture rather than two unrelated things moving.

     On the base class, so the full-size dots and the 2Go images get the
     same cue from one rule. It is only the sizing above that had to
     separate them. */
  .wt-bubble__swatch {
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  /* position/z-index are here and not in the rule above because they
     only matter while lifted: the grown swatch has to sit over its
     neighbours, and at the 4px phone gap it certainly overlaps them. A
     later sibling would otherwise paint on top of it. */
  .wt-bubble__swatch:hover {
    position: relative;
    z-index: 1;
    transform: scale(1.35);
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px rgba(0, 0, 0, 0.18);
  }

  /* The ring stays -- it is the part that says which swatch is showing,
     and it does not move. Only the growing is dropped. */
  @media (prefers-reduced-motion: reduce) {
    .wt-bubble__swatch {
      transition: none;
    }

    .wt-bubble__swatch:hover {
      transform: none;
    }
  }

  /* Close to .wt-btn but inline-block with 14px/24px padding, so it
     stays a separate rule rather than .wt-btn plus overrides. */
  .wt-blocks__cta,
  .wt-bubble__cta {
    display: inline-block;
    background: var(--wt-red);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 24px;
    border-radius: var(--wt-btn-radius);
  }
  /* ============================================================
     "How do you want to play?" grid
     (snippets/wt-play.liquid, rendered as #more)
     The snippet is rendered only from this section file and lands
     inside .wt-home, so its rules live here and the shared tokens
     resolve for it.

     Compound selector so the padding override outranks .wt-section
     on specificity, not on source order.
     ============================================================ */
  .wt-section.wt-play {
    --wt-section-pad-top: 72px; /* .wt-section default is 32px */

    --wt-play-media-radius: 12px;
  }

  .wt-play__title {
    margin: 0 0 8px;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(27px, 6vw, 36px);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }

  .wt-play__lead {
    margin: 0 0 28px;
    font-size: 16px;
    color: var(--wt-muted);
  }

  .wt-play__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .wt-play__card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .wt-play__media {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: var(--wt-play-media-radius);
    overflow: hidden;
    background: var(--wt-mist);
  }

  /* Padded 10%, not the 8% the other contain-fit images use, so this
     deliberately does not join that shared rule. */
  .wt-play__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10%;
  }

  .wt-play__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wt-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Shallower and two-stop where --wt-hero-scrim is four, so this is
     its own gradient rather than the shared hero one. */
  .wt-play__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 20px;
    background: linear-gradient(
      to top,
      rgba(16, 16, 18, 0.9) 0%,
      rgba(16, 16, 18, 0.6) 55%,
      rgba(16, 16, 18, 0) 100%
    );
  }

  .wt-play__verb {
    display: block;
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: clamp(21px, 5vw, 28px);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    color: #fff;
  }

  .wt-play__sub {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    color: #fff;
    opacity: 0.85;
  }
  /* ============================================================
     Shared image fill  (snippets/wt-img.liquid)
     Rendered from this section and from wt-bubble, both of which sit
     inside .wt-home, so the shared tokens resolve for it.

     The fit mode used to be interpolated straight into the inline
     style; it is now a modifier class. Only 'cover' and 'contain'
     have rules -- the two values the call sites use. A different
     value would leave object-fit unset rather than passing through.

     The base sets no object-fit, so the modifiers have no property
     to fight over and need no compound selector.
     ============================================================ */
  .wt-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wt-img--cover {
    object-fit: cover;
  }

  .wt-img--contain {
    object-fit: contain;
    padding: 8%;
  }

  /* Same idea as .wt-play__placeholder, but with a background, inner
     padding and centred text, so it stays a separate rule. */
  .wt-img__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 14px;
    background: var(--wt-mist);
    color: var(--wt-faint);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  /* ============================================================
     Mobile
     Everything above is the desktop layout and is left untouched;
     this block only narrows things below 768px.

     Note on specificity: a media query adds none. Where a desktop
     rule uses a compound selector, the mobile override has to
     repeat that compound form or it will lose the cascade.
     ============================================================ */
  @media (max-width: 767px) {
    /* ---------- section rhythm ----------
       Each compound desktop override has to be repeated in its
       compound form; a plain .wt-section here would lose to them. */
    .wt-home {
      --wt-card-gap: 12px;
    }

    .wt-section {
      --wt-section-pad-x: 20px;
      --wt-section-pad-top: 24px;
    }

    .wt-section.wt-flavour {
      --wt-section-pad-top: 28px;
      --wt-flavour-gap: 12px;
    }

    .wt-section.wt-knead {
      --wt-section-pad-top: 40px;
      --wt-knead-gap: 28px;
    }

    .wt-section.wt-tagd {
      --wt-section-pad-top: 40px;
      --wt-tagd-gap: 28px;
    }

    .wt-section.wt-play {
      --wt-section-pad-top: 40px;
    }

    .wt-section.wt-trust {
      --wt-section-pad-top: 40px;
      --wt-section-pad-bottom: 40px;
    }

    .wt-section.wt-bubble__inner {
      --wt-section-pad-top: 40px;
      --wt-section-pad-bottom: 40px;
    }

    .wt-section.wt-newsletter__inner {
      --wt-section-pad-top: 40px;
      --wt-section-pad-bottom: 40px;
    }

    .wt-new {
      --wt-new-gap: 20px;
    }

    /* ---------- content grids: single column ----------
       .wt-new__card matters most: its desktop track list starts with
       a hard 340px, which overflows a 375px viewport on its own.
       .wt-knead__styles is deliberately absent -- it stays at five
       across, reading as a strip rather than a stack. */
    .wt-hero__grid,
    .wt-new__card,
    .wt-knead__grid,
    .wt-tagd__grid,
    .wt-trust__grid,
    .wt-bubble__cards,
    .wt-blocks__cards {
      grid-template-columns: 1fr;
    }

    /* ---------- product grids: two columns ---------- */
    /* The tag'd row is not here: it turned into a swipeable strip at
       1099px and stays one down here, where two columns would be four
       rows and an orphan. */
    .wt-flavour__grid,
    .wt-play__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* ---------- gaps that are literal, not tokenised ---------- */
    .wt-trust__grid {
      gap: 28px;
      padding-top: 28px;
    }

    .wt-blocks__head,
    .wt-bubble__head {
      gap: 20px;
    }

    .wt-blocks__cards,
    .wt-bubble__cards {
      gap: 16px;
    }

    .wt-play__grid {
      gap: 12px;
    }

    .wt-tagd__row {
      gap: 10px;
    }

    /* ---------- roomy padding inside cards and overlays ---------- */
    .wt-hero__overlay {
      padding: 24px;
    }

    .wt-hero__card-overlay {
      padding: 20px;
    }

    .wt-blocks__body,
    .wt-bubble__body {
      padding: 20px;
    }

    /* Token, not a rule override: the card body loses 8px of padding
       on each side here, so the eighteen swatches need the tighter
       gutter to keep the same number of rows. */
    .wt-bubble {
      --wt-bubble-swatch-img-gap: 4px;
    }

    .wt-play__overlay {
      padding: 14px;
    }

    /* The desktop padding here is asymmetric because the card is a
       three-column row. Stacked, the media sits edge to edge and the
       text below it needs padding on both sides instead. */
    .wt-new__body {
      padding: 20px 20px 0;
    }

    .wt-new__buy {
      padding: 0 20px 20px;
      justify-items: start;
    }

    /* ---------- fixed heights ---------- */
    .wt-hero__feature {
      min-height: 380px;
    }

    .wt-hero__card {
      min-height: 200px;
    }

    /* A 300px floor leaves the field stranded beside a wrapped
       button; let it fill the row instead. */
    .wt-newsletter__input {
      min-width: 0;
      width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Hero image switcher (#top). Drives both pill groups: the feature's
     flavours and the endless bubble card's two sizes.

     All the state is one attribute -- data-wt-option on whichever block
     the pills sit in -- and the CSS does the rest: the cross-fade and the
     active pill both key off it. So every handler here does the same one
     thing, and nothing has to read the DOM to find out what is currently
     showing.

     Delegated from the document rather than bound to the pills: this
     bundle is shared across sections and runs once, with no guarantee
     the hero is in the DOM at the time, and a theme-editor re-render
     replaces the pills without re-running it.

     mouseout and focusout stand in for mouseleave and blur because only
     the bubbling pair reaches a delegated listener; the relatedTarget
     test in release() is what turns them back into "left the group". */
  (function () {
    var GROUP = '.wt-hero__pills';

    function groupFrom(node) {
      if (!node || typeof node.closest !== 'function') return null;
      return node.closest(GROUP);
    }

    function pillFrom(node) {
      if (!node || typeof node.closest !== 'function') return null;
      return node.closest(GROUP + ' [data-wt-option]');
    }

    /* The root is whichever block carries the attribute -- the feature
       panel or the bubble card. Climbing to it rather than naming it is
       the whole of what makes one switcher serve both. */
    function show(group, option) {
      var root = group.closest('[data-wt-option]');
      if (!root) return;

      root.setAttribute('data-wt-option', option);

      var pills = group.querySelectorAll('[data-wt-option]');
      var active = null;
      for (var i = 0; i < pills.length; i++) {
        var isActive = pills[i].getAttribute('data-wt-option') === option;
        if (isActive) active = pills[i];
        pills[i].classList.toggle('wt-hero__pill--active', isActive);

        /* Only the pills that ship the attribute get it maintained --
           the tag'd dots, whose white fill is the only thing that says
           which style is showing. The labelled pills elsewhere say it in
           words, so they are left as plain buttons. */
        if (pills[i].hasAttribute('aria-pressed')) {
          pills[i].setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      }

      /* Only the tag'd dots ship a url, because only that card is nine
         separate products behind one picture. The flavour and bubble
         cards are one product each and keep the link they rendered
         with, so the absence of the attribute is the whole condition --
         nothing here needs to know which card it is looking at. */
      var url = active && active.getAttribute('data-wt-url');
      var link = url && root.querySelector('[data-wt-card-link]');
      if (link) link.setAttribute('href', url);
    }

    /* The first pill is the default, so a group states its own fallback
       instead of this file knowing that one starts on sushi and the
       other on full size. */
    function defaultOption(group) {
      var first = group.querySelector('[data-wt-option]');
      return first ? first.getAttribute('data-wt-option') : null;
    }

    /* Hover is a preview and a click is a choice, and only the second
       survives the pointer leaving. Without the difference the tag'd
       caret would be pointless: it advances the card, and then brushing
       the dot row on the way past would drop it back to the first style.

       Kept on the group as an attribute so nothing has to be initialised
       -- a group that has never been clicked simply has none, and falls
       back to the first pill exactly as before. */
    function committed(group) {
      return group.getAttribute('data-wt-committed') || defaultOption(group);
    }

    function commit(group, option) {
      group.setAttribute('data-wt-committed', option);
      show(group, option);
    }

    /* Hover and keyboard focus are the same gesture as far as the hero is
       concerned, so they share a handler. */
    function activate(event) {
      var pill = pillFrom(event.target);
      if (!pill) return;
      show(pill.closest(GROUP), pill.getAttribute('data-wt-option'));
    }

    function release(event) {
      var group = groupFrom(event.target);
      if (!group) return;

      /* Moving between two pills never leaves the group. */
      if (group.contains(event.relatedTarget)) return;

      /* The pointer wandering off should not yank the image out from
         under someone who tabbed to a pill and is still sitting on it. */
      if (group.contains(document.activeElement)) return;

      var fallback = committed(group);
      if (fallback) show(group, fallback);
    }

    document.addEventListener('mouseover', activate);
    document.addEventListener('focusin', activate);
    document.addEventListener('mouseout', release);
    document.addEventListener('focusout', release);

    /* Touch has no hover to switch on, so the tap has to do it. Sushi is a
       real link to the collection and is left alone; every other pill is a
       button with nowhere to go, so its default is swallowed -- on the
       bubble card that is also what keeps the tap off the card's own
       stretched link. */
    document.addEventListener('click', function (event) {
      var pill = pillFrom(event.target);
      if (!pill || pill.tagName === 'A') return;

      event.preventDefault();
      commit(pill.closest(GROUP), pill.getAttribute('data-wt-option'));
    });

    /* The tag'd card's caret. It has no option of its own -- it reads
       the one the card is showing and takes the next, wrapping at the
       end, so nine styles need one button and no numbering.

       It asks the pills for the order rather than counting products:
       they are already the list, in the order the card draws them. */
    document.addEventListener('click', function (event) {
      if (!event.target || typeof event.target.closest !== 'function') return;

      var caret = event.target.closest('[data-wt-next]');
      if (!caret) return;

      event.preventDefault();

      var root = caret.closest('[data-wt-option]');
      var group = root && root.querySelector(GROUP);
      if (!group) return;

      var options = group.querySelectorAll('[data-wt-option]');
      if (!options.length) return;

      var current = root.getAttribute('data-wt-option');
      var index = 0;
      for (var i = 0; i < options.length; i++) {
        if (options[i].getAttribute('data-wt-option') === current) {
          index = i;
          break;
        }
      }

      var following = options[(index + 1) % options.length];
      commit(group, following.getAttribute('data-wt-option'));
    });
  })();

  /* Colour swatches on both bubble cards (#bubble). Hovering one puts
     that colour in the card photo above it; leaving the row puts the
     default back. It serves the full-size card's six named dots and the
     2Go card's eighteen photographed ones without knowing which is
     which -- a row states its colours in the markup, and the card it is
     answering for is whichever one it sits in.

     Nothing like the hero switcher above, and deliberately so. There the
     state is an attribute and the CSS cross-fades between images that
     are all already in the DOM, which is affordable at two or six. Over
     both rows here it is twenty-four, so the photo is one <img> and this
     swaps its src. The trade is a possible blink on a colour's first
     showing, which is what warm() buys back: the first time a pointer
     touches a row, that row's colours are fetched into the browser
     cache, and by the time it has crossed the first swatch the rest are
     already there. A visitor who hovers one card never pays for the
     other.

     Delegated from the document for the same reasons as the hero: shared
     bundle, no guarantee the card is in the DOM yet, and a theme-editor
     re-render replaces the row without re-running this. */
  (function () {
    var ROW = '[data-wt-swatches]';
    var SWATCH = ROW + ' [data-wt-photo]';
    var warmed = [];

    function rowFrom(node) {
      if (!node || typeof node.closest !== 'function') return null;
      return node.closest(ROW);
    }

    function show(row, src) {
      var card = row.closest('.wt-bubble__card');
      var img = card && card.querySelector('.wt-bubble__img');

      /* No src means the card fell back to the theme-setting photo,
         which is a different element and not ours to swap. */
      if (!img || !src) return;
      if (img.getAttribute('src') === src) return;

      /* Only the src moves. The alt names the product, and the product
         is the same one in every photo the row offers -- the colours it
         names are named in the row's own label, not here. */
      img.setAttribute('src', src);
    }

    /* Once per row, and only on the first pointer that reaches it: a
       visitor who never goes near the swatches never pays for this. */
    function warm(row) {
      if (warmed.indexOf(row) !== -1) return;
      warmed.push(row);

      var swatches = row.querySelectorAll('[data-wt-photo]');
      for (var i = 0; i < swatches.length; i++) {
        var preload = new Image();
        preload.src = swatches[i].getAttribute('data-wt-photo');
      }
    }

    function activate(event) {
      var row = rowFrom(event.target);
      if (!row) return;

      warm(row);

      var swatch = event.target.closest(SWATCH);
      if (swatch) show(row, swatch.getAttribute('data-wt-photo'));
    }

    function release(event) {
      var row = rowFrom(event.target);
      if (!row) return;

      /* Moving between two swatches never leaves the row. */
      if (row.contains(event.relatedTarget)) return;

      var card = row.closest('.wt-bubble__card');
      var img = card && card.querySelector('.wt-bubble__img');
      if (img) show(row, img.getAttribute('data-wt-photo-default'));
    }

    document.addEventListener('mouseover', activate);
    document.addEventListener('mouseout', release);

    /* Touch has no hover, so the tap has to do it, and there is no
       matching "off" gesture to put the default back -- the colour that
       was tapped stays up until another one is. Which is the right way
       round for a row of colours: on a phone it behaves like a picker,
       and the swatches are plain images with nothing to navigate to, so
       there is no default to swallow. */
    document.addEventListener('click', function (event) {
      var row = rowFrom(event.target);
      if (!row) return;

      var swatch = event.target.closest(SWATCH);
      if (swatch) show(row, swatch.getAttribute('data-wt-photo'));
    });
  })();
{% endjavascript %}
