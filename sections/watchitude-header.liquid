{%- comment -%}
  One source for the primary nav. The same links have to appear twice --
  once in the desktop row, once inside the mobile drawer -- and two hand
  written copies would drift the first time a collection is renamed. So
  the markup is built once and captured, then printed into both places.

  Liquid has no object literals, so the labels and their collection
  handles ride in two arrays walked by a shared index.
{%- endcomment -%}
{%- liquid
  assign nav_labels = "Knead That|Endless Bubble|Tag'd|Fidgets|Slap Watches|New" | split: '|'
  assign nav_handles = 'knead-that|endless-bubble|tagd|fidgets|slap-watches|new' | split: '|'
-%}
{%- capture nav_links -%}
  {%- for label in nav_labels -%}
    {%- assign handle = nav_handles[forloop.index0] -%}
    {%- assign link_class = 'wt-header__link' -%}
    {%- if handle == 'new' -%}
      {%- assign link_class = 'wt-header__link wt-header__link--new' -%}
    {%- endif -%}
    <a href="{{ routes.collections_url }}/{{ handle }}" class="{{ link_class }}">{{ label }}</a>
  {%- endfor -%}
{%- endcapture -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Jost:wght@500;600;700&display=swap"
>
<div class="wt-header">
  {% if section.settings.show_announcement %}
    <div class="wt-header__announcement">
      {{ section.settings.announcement_text }}
    </div>
  {% endif %}
  <header class="wt-header__bar">
    <div class="wt-header__row">
      <a href="{{ routes.root_url }}" class="wt-header__logo">
        {%- if section.settings.logo -%}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            alt="{{ shop.name }}"
            class="wt-header__logo-img"
          >
        {%- else -%}
          <span class="wt-header__wordmark"
            >watchitude</span
          >
        {%- endif -%}
      </a>
      <nav class="wt-header__nav">
        {{ nav_links }}
      </nav>
      <div class="wt-header__utils">
        <a href="{{ routes.search_url }}" class="wt-header__util">Search</a>
        <a href="{{ routes.account_url }}" class="wt-header__util">Account</a>
        <a
          href="{{ routes.cart_url }}"
          class="wt-header__cart"
          >Cart
          <span class="wt-header__cart-count">
            {{- cart.item_count -}}
          </span></a
        >
      </div>
      <details class="wt-header__drawer">
        <summary class="wt-header__toggle">Menu</summary>
        <nav class="wt-header__drawer-nav">
          {{ nav_links }}
        </nav>
      </details>
    </div>
  </header>
</div>
{% stylesheet %}
  /* ============================================================
     Watchitude header
     Self-contained by necessity. Shopify subsets styles.css so a
     page only loads the CSS of files in its render tree, and this
     header renders on every page while watchitude-home does not --
     so nothing here may depend on .wt-home's tokens or .wt-section.
     The few token values below are therefore declared locally and
     mirror their counterparts in watchitude-home.liquid.
     ============================================================ */
  .wt-header {
    --wt-header-max: 1400px;
    --wt-header-pad-x: 32px;
    --wt-header-gap: 32px;

    --wt-font-body: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    --wt-font-display: 'Jost', 'Century Gothic', Futura, sans-serif;
    --wt-red: #D71920;
    --wt-ink: #101012;
    --wt-line: #E2E2E4;
    --wt-muted: #5A5A61;

    font-family: var(--wt-font-body);
    color: var(--wt-ink);
  }

  .wt-header__announcement {
    background: var(--wt-red);
    color: #fff;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 9px 16px;
  }

  .wt-header__bar {
    border-bottom: 1px solid var(--wt-line);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .wt-header__row {
    max-width: var(--wt-header-max);
    margin: 0 auto;
    padding: 14px var(--wt-header-pad-x);
    display: flex;
    align-items: center;
    gap: var(--wt-header-gap);
  }

  /* ---------- logo ---------- */
  .wt-header__logo {
    flex: 0 0 auto;
    display: block;
    width: 190px;
  }

  .wt-header__logo-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .wt-header__wordmark {
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    color: var(--wt-ink);
  }

  /* ---------- primary nav ----------
     white-space: nowrap on the links is what pinned the page's
     minimum width. Below 768px this whole row is hidden in favour of
     the drawer, so it no longer costs anything there. */
  .wt-header__nav {
    flex: 1 1 auto;
    display: flex;
    gap: 26px;
    align-items: center;
  }

  .wt-header__link {
    font-size: 15px;
    font-weight: 600;
    color: var(--wt-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /* Compound: overrides the base rule's colour, so it wins on
     specificity rather than source order. */
  .wt-header__link.wt-header__link--new {
    color: var(--wt-red);
  }

  /* ---------- utility cluster ---------- */
  .wt-header__utils {
    flex: 0 0 auto;
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
  }

  .wt-header__util {
    color: var(--wt-muted);
    text-decoration: none;
  }

  .wt-header__cart {
    color: var(--wt-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .wt-header__cart-count {
    background: var(--wt-red);
    color: #fff;
    border-radius: 999px;
    min-width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  /* ---------- mobile drawer ----------
     In the markup at every width but hidden outright above 768px,
     where .wt-header__nav is the copy that shows. Both are printed
     from the same captured markup, so they cannot drift.

     The panel stays in normal flow on purpose: it is a child of the
     header row, not an absolutely positioned overlay, so opening it
     grows the header and pushes the page down instead of covering
     it. That is also why the <details> is full width -- the panel
     cannot be wider than the box it sits in, so the summary has to
     take a line of its own beneath the logo. */
  .wt-header__drawer {
    display: none;
    width: 100%;
    border-top: 1px solid var(--wt-line);
  }

  .wt-header__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--wt-ink);
    cursor: pointer;
    /* Three goes at killing the default marker, because no one of
       them covers every browser: list-style for Firefox, the
       -webkit- pseudo-element below for Safari, and display:flex,
       which takes the summary out of list-item display in Chrome. */
    list-style: none;
  }

  .wt-header__toggle::-webkit-details-marker {
    display: none;
  }

  /* Chevron drawn from two borders rather than a glyph, so it does
     not wait on the webfont. */
  .wt-header__toggle::after {
    content: '';
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--wt-muted);
    border-bottom: 2px solid var(--wt-muted);
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.15s ease;
  }

  .wt-header__drawer[open] .wt-header__toggle::after {
    transform: translateY(2px) rotate(-135deg);
  }

  .wt-header__drawer-nav {
    display: grid;
    padding-bottom: 8px;
  }

  /* Compound, so it beats .wt-header__link on specificity rather
     than on source order. */
  .wt-header__drawer-nav .wt-header__link {
    padding: 11px 0;
    border-top: 1px solid var(--wt-line);
  }

  /* ============================================================
     Mobile
     Everything above is the desktop layout and is left untouched;
     this block only narrows things below 768px.

     The row keeps its flex layout and is allowed to wrap: the logo
     and the utility cluster share line one, and the drawer -- being
     width:100% -- takes the whole of line two.
     ============================================================ */
  @media (max-width: 767px) {
    .wt-header {
      --wt-header-pad-x: 20px;
      --wt-header-gap: 12px;
    }

    .wt-header__row {
      flex-wrap: wrap;
      padding-top: 12px;
      /* The drawer carries its own bottom padding, open or closed. */
      padding-bottom: 0;
    }

    .wt-header__logo {
      width: 140px;
    }

    .wt-header__nav {
      display: none;
    }

    /* The hidden nav was the flex:1 spacer holding the utilities
       against the right edge; margin-left takes over that job. */
    .wt-header__utils {
      margin-left: auto;
      gap: 14px;
      font-size: 13px;
    }

    .wt-header__drawer {
      display: block;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* <details> opens and closes itself; the one case it cannot handle is
     a link that never leaves the page. A same-page anchor such as
     /#flavour only changes the hash, so the drawer would stay open on
     top of the section the visitor just jumped to. Closing it on any
     link click inside the drawer covers that, and costs nothing on a
     real navigation, where the next page renders it closed anyway.

     Delegated from the document rather than bound to the element: this
     bundle is shared across sections and runs once, with no guarantee
     the header is in the DOM at the time. */
  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!target || typeof target.closest !== 'function') return;

    /* Requiring an <a> is what keeps the summary from tripping this --
       a click on the summary is how the drawer gets opened. */
    var link = target.closest('.wt-header__drawer a');
    if (!link) return;

    var drawer = link.closest('.wt-header__drawer');
    if (drawer) drawer.open = false;
  });
{% endjavascript %}

{% schema %} { "name": "Watchitude header", "settings": [ { "type": "image_picker", "id": "logo", "label": "Logo" }, { "type": "checkbox", "id": "show_announcement", "label": "Show announcement bar", "default": true }, { "type": "text", "id": "announcement_text", "label": "Announcement text", "default": "Orders over $20 ship free" } ] } {% endschema %}
