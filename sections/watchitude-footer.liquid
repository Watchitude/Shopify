<div class="wt-footer">
  <footer class="wt-footer__main">
    <div class="wt-footer__grid">
      <div>
        {%- if section.settings.logo -%}
          <img
            src="{{ section.settings.logo | image_url: width: 360 }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            alt="{{ shop.name }}"
            class="wt-footer__logo-img"
          >
        {%- else -%}
          <span class="wt-footer__wordmark">watchitude</span>
        {%- endif -%}
        <p class="wt-footer__blurb">Fidgets, slap watches and mystery boxes made for kids and tested to prove it.</p>
      </div>
      <div>
        <h4 class="wt-footer__heading">Shop</h4>
        <div class="wt-footer__list">
          <a href="{{ routes.collections_url }}/knead-that" class="wt-footer__link">Knead That</a>
          <a href="{{ routes.collections_url }}/endless-bubble" class="wt-footer__link">Endless Bubble</a>
          <a href="{{ routes.collections_url }}/tagd" class="wt-footer__link">Tag'd 2</a>
          <a href="{{ routes.collections_url }}/fidgets" class="wt-footer__link">Fidgets</a>
          <a href="{{ routes.collections_url }}/slap-watches" class="wt-footer__link">Slap Watches</a>
        </div>
      </div>
      <div>
        <h4 class="wt-footer__heading">Help</h4>
        <div class="wt-footer__list">
          <a href="/pages/contact" class="wt-footer__link">Contact Us</a>
          <a href="{{ shop.shipping_policy.url }}" class="wt-footer__link">Shipping</a>
          <a href="{{ shop.refund_policy.url }}" class="wt-footer__link">Returns</a>
          <a href="/pages/find-a-store" class="wt-footer__link">Find a Store</a>
        </div>
      </div>
      <div>
        <h4 class="wt-footer__heading">Wholesale</h4>
        <div class="wt-footer__list">
          <a href="/pages/wholesale" class="wt-footer__link">Become a Retailer</a>
          <a href="/pages/fundraising" class="wt-footer__link">Fundraising</a>
          <a href="/pages/press" class="wt-footer__link">Press</a>
        </div>
      </div>
    </div>
    <div class="wt-footer__legal">
      <div class="wt-footer__legal-inner">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &reg;. All rights reserved.</div>
    </div>
  </footer>
</div>
{% stylesheet %}
  /* ============================================================
     Watchitude footer
     Self-contained for the same reason the header is: Shopify
     subsets styles.css to the files in a page's render tree, and
     nothing guarantees watchitude-home is in it. The tokens below
     are therefore declared locally and mirror their counterparts
     in watchitude-header.liquid and watchitude-home.liquid.

     The Archivo/Jost <link> tags are deliberately not repeated
     here. They live in watchitude-header.liquid, which renders on
     every page via header-group.json, and they are markup rather
     than CSS, so the subsetting above does not reach them.

     Pure extraction: every declaration is carried over from the
     inline style it replaces, unchanged. No breakpoints yet -- the
     four-column grid still holds at every width.
     ============================================================ */
  .wt-footer {
    --wt-footer-max: 1400px;
    --wt-footer-pad-x: 32px;
    --wt-footer-gap: 40px;

    --wt-font-body: 'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    --wt-font-display: 'Jost', 'Century Gothic', Futura, sans-serif;
    --wt-ink: #101012;
    --wt-line: #E2E2E4;
    --wt-muted: #5A5A61;

    font-family: var(--wt-font-body);
    color: var(--wt-ink);
  }

  .wt-footer__main {
    border-top: 1px solid var(--wt-line);
    background: #fff;
  }

  /* The 1.4fr column and the 40px gaps are what pin the footer's
     minimum width; both are left exactly as they were so this
     commit stays a no-op on desktop. */
  .wt-footer__grid {
    max-width: var(--wt-footer-max);
    margin: 0 auto;
    padding: 48px var(--wt-footer-pad-x);
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--wt-footer-gap);
  }

  /* ---------- brand column ---------- */
  .wt-footer__logo-img {
    width: 170px;
    height: auto;
    display: block;
    margin-bottom: 14px;
  }

  /* The branch that actually renders today: the footer's logo
     setting is empty on the theme, so the wordmark is the live
     brand mark and the rule above is latent until one is uploaded. */
  .wt-footer__wordmark {
    font-family: var(--wt-font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    display: block;
    margin-bottom: 14px;
  }

  .wt-footer__blurb {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--wt-muted);
  }

  /* ---------- link columns ----------
     Dawn styles bare h4 twice, at assets/base.css:263 and :345, and
     the inline style this rule replaces was the only thing holding
     those off. A class outranks a bare element selector, so the
     cascade still lands the same way -- but every line below is
     load-bearing, and dropping any one of them lets its Dawn
     counterpart surface:

       font-weight    -> var(--font-heading-weight)
       font-size      -> calc(var(--font-heading-scale) * 1.5rem)
       letter-spacing -> calc(var(--font-heading-scale) * 0.06rem)
       color          -> rgb(var(--color-foreground))

     font-family, font-style, line-height and word-break are absent
     on purpose. The inline style never set them either, so they
     already come from Dawn today and have to keep coming from Dawn
     for this to stay a no-op. */
  .wt-footer__heading {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wt-muted);
  }

  .wt-footer__list {
    display: grid;
    gap: 9px;
  }

  .wt-footer__link {
    font-size: 15px;
    color: var(--wt-ink);
    text-decoration: none;
  }

  /* ---------- legal bar ---------- */
  .wt-footer__legal {
    border-top: 1px solid var(--wt-line);
  }

  .wt-footer__legal-inner {
    max-width: var(--wt-footer-max);
    margin: 0 auto;
    padding: 20px var(--wt-footer-pad-x);
    font-size: 13px;
    color: var(--wt-muted);
  }

  /* ============================================================
     Mobile
     Everything above is the desktop layout and is left untouched;
     this block only narrows things below 768px.

     The four-column grid was the footer's minimum width: fr tracks
     carry min-width:auto, so no track could shrink below its
     longest unbreakable word and four of them could not collapse
     into fewer. One column removes that floor outright. The gap
     and horizontal padding come down through the tokens, so the
     grid and the legal bar both follow from one change each.
     ============================================================ */
  @media (max-width: 767px) {
    .wt-footer {
      --wt-footer-pad-x: 20px;
      --wt-footer-gap: 28px;
    }

    .wt-footer__grid {
      grid-template-columns: 1fr;
      /* Shorthand rather than longhands: --wt-footer-pad-x is
         already 20px in here, so this reads 32px 20px. */
      padding: 32px var(--wt-footer-pad-x);
    }

    .wt-footer__logo-img {
      width: 140px;
    }

    /* The 9px gap gives way to padding on the links themselves --
       spacing between rows becomes part of the tap target instead
       of dead space beside it. */
    .wt-footer__list {
      gap: 0;
    }

    /* 15px text on Dawn's body line-height is a ~22px box; 11px
       top and bottom carries each row past the 44px minimum. */
    .wt-footer__link {
      padding: 11px 0;
    }

    .wt-footer__legal-inner {
      padding: 16px var(--wt-footer-pad-x);
    }
  }
{% endstylesheet %}

{% schema %} { "name": "Watchitude footer", "settings": [ { "type": "image_picker", "id": "logo", "label": "Logo" } ] } {% endschema %}
