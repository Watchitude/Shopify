<section id="more" style="max-width:1400px;margin:0 auto;padding:72px 32px 8px"> <h2 style="margin:0 0 8px;font-family:'Jost','Century Gothic',Futura,sans-serif;font-weight:700;font-size:36px;line-height:1;letter-spacing:-.04em;text-transform:lowercase">how do you want to play?</h2> <p style="margin:0 0 28px;font-size:16px;color:#5A5A61">Shop by what your hands do with it.</p> <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px"> {% assign play_handles = 'squish-it,click-it,spin-it,launch-it' | split: ',' %} {% assign play_verbs = 'squish it,click it,spin it,launch it' | split: ',' %} {% assign play_subs = 'Knead That plush,Keys and blocks,Spinners and cubes,Rocket kites' | split: ',' %} {% for handle in play_handles %} {% assign col = collections[handle] %} <a href="{{ col.url | default: '/collections/all' }}" style="text-decoration:none;color:inherit;display:block"> <div style="position:relative;aspect-ratio:4/5;border-radius:12px;overflow:hidden;background:#F4F4F5"> {% if col.products.first.featured_image %}<img src="{{ col.products.first.featured_image | image_url: width: 700 }}" alt="{{ col.title }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:10%">{% else %}<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#9a9aa2;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase">Photo needed</div>{% endif %} <div style="position:absolute;left:0;right:0;bottom:0;padding:20px;background:linear-gradient(to top,rgba(16,16,18,.9) 0%,rgba(16,16,18,.6) 55%,rgba(16,16,18,0) 100%)"> <span style="display:block;font-family:'Jost','Century Gothic',Futura,sans-serif;font-weight:700;font-size:28px;line-height:1;letter-spacing:-.04em;text-transform:lowercase;color:#fff">{{ play_verbs[forloop.index0] }}</span> <span style="display:block;margin-top:6px;font-size:13px;color:#fff;opacity:.85">{{ play_subs[forloop.index0] }}</span> </div> </div> </a> {% endfor %} </div> </section>