<section id="more" class="wt-section wt-play">
  <h2 class="wt-play__title">how do you want to play?</h2>
  <p class="wt-play__lead">Shop by what your hands do with it.</p>
  <div class="wt-play__grid">
    {% assign play_handles = 'squish-it,click-it,spin-it,launch-it' | split: ',' %}
    {% assign play_verbs = 'squish it,click it,spin it,launch it' | split: ',' %}
    {% assign play_subs = 'Knead That plush,Keys and blocks,Spinners and cubes,Rocket kites' | split: ',' %}
    {% for handle in play_handles %}
    {% assign col = collections[handle] %}
    <a href="{{ col.url | default: '/collections/all' }}" class="wt-play__card">
      <div class="wt-play__media">
        {% if col.products.first.featured_image %}<img src="{{ col.products.first.featured_image | image_url: width: 700 }}" alt="{{ col.title }}" class="wt-play__img">{% else %}<div class="wt-play__placeholder">Photo needed</div>{% endif %}
        <div class="wt-play__overlay">
          <span class="wt-play__verb">{{ play_verbs[forloop.index0] }}</span>
          <span class="wt-play__sub">{{ play_subs[forloop.index0] }}</span>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
