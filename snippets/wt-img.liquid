{% if img != blank %}<img src="{{ img | image_url: width: 1400 }}" alt="{{ alt }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:{{ fit | default: 'cover' }};{% if fit == 'contain' %}padding:8%;{% endif %}">{% else %}<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:14px;background:#F4F4F5;color:#9a9aa2;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;line-height:1.5">{{ label }}</div>{% endif %}