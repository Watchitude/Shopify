{% assign b_full = all_products['endless-bubble-wrap-dark-blue'] %}
{% assign b_2go = all_products['endless-bubble-2go-blind-bag'] %}
<div class="wt-bubble__cards">
  <article class="wt-bubble__card">
    <div class="wt-bubble__media">{% if b_full.featured_image %}<img src="{{ b_full.featured_image | image_url: width: 900 }}" alt="{{ b_full.title }}" class="wt-bubble__img">{% endif %}</div>
    <div class="wt-bubble__body">
      <div class="wt-bubble__row">
        <h3 class="wt-bubble__name">Full size</h3>
        <span class="wt-bubble__price">{{ b_full.price | money_without_trailing_zeros | default: '$20' }}</span>
      </div>
      <p class="wt-bubble__copy">Six colors, silicone, dishwasher-safe. The one that lives on the coffee table.</p>
      <div class="wt-bubble__swatches">
        <span class="wt-bubble__swatch wt-bubble__swatch--red"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--pink"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--sky"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--blue"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--green"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--violet"></span>
      </div>
      <a href="/collections/endless-bubble" class="wt-bubble__cta">Shop full size</a>
    </div>
  </article>
  <article class="wt-bubble__card">
    <div class="wt-bubble__media">{% if b_2go.featured_image %}<img src="{{ b_2go.featured_image | image_url: width: 900 }}" alt="{{ b_2go.title }}" class="wt-bubble__img">{% else %}{% render 'wt-img', img: section.settings.twogo_image, label: '2Go blind bag photo', fit: 'contain' %}{% endif %}</div>
    <div class="wt-bubble__body">
      <div class="wt-bubble__row">
        <h3 class="wt-bubble__name">2Go blind bag</h3>
        <span class="wt-bubble__price">{{ b_2go.price | money_without_trailing_zeros | default: '$13.50' }}</span>
      </div>
      <p class="wt-bubble__copy">Keychain size with a carabiner. Blind bag &mdash; the color is the surprise. Halloween and holiday displays available.</p>
      <div class="wt-bubble__swatches">
        <span class="wt-bubble__swatch wt-bubble__swatch--ink"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--orange"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--violet"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--green"></span>
        <span class="wt-bubble__swatch wt-bubble__swatch--yellow"></span>
        <span class="wt-bubble__swatch-note">+ glow</span>
      </div>
      <a href="{{ b_2go.url | default: '/collections/endless-bubble' }}" class="wt-bubble__cta">Shop 2Go</a>
    </div>
  </article>
</div>
